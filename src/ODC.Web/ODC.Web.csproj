<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ODC.Web</RootNamespace>
    <UserSecretsId>odc-web-3b8f9c52-6a41-4e0b-9d7e-2f5c1a7e8d10</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Markdig" />
    <!-- libvips: fast, low-memory image processing with an AVIF (AV1) encoder; native binaries for Windows, Linux and macOS. -->
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- JWT access tokens (ES256): the token handler used by ASP.NET Core JwtBearer. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Postgresql.Alternative" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translations are embedded resources (Directory.Build.props), not published content. -->
    <Content Remove="Shared\Localization\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ODC.UnitTests" />
  </ItemGroup>

  <!-- Publishing builds the single-page application (src/ODC.Client, pnpm) and ships it as ClientApp (served at /).
       Skip with -p:SkipClientBuild=true when the client was built separately. -->
  <PropertyGroup>
    <ClientRoot>$(MSBuildProjectDirectory)\..\ODC.Client</ClientRoot>
  </PropertyGroup>

  <!-- Running from Visual Studio (or dotnet run/build) builds the client too, but only when it is missing or its sources
       changed since the last build (MSBuild compares the timestamps of Inputs and Outputs), so a build with an unchanged
       client costs nothing. Dependencies are installed when the lockfile changed. Design-time builds of the IDE, publishing
       (BuildClient below) and -p:SkipClientBuild=true skip it. -->
  <PropertyGroup>
    <ClientDevBuild Condition="'$(SkipClientBuild)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(_IsPublishing)' != 'true'">true</ClientDevBuild>
    <ClientInstallStamp>$(BaseIntermediateOutputPath)client-install.stamp</ClientInstallStamp>
  </PropertyGroup>

  <ItemGroup Condition="'$(ClientDevBuild)' == 'true'">
    <ClientSource Include="$(ClientRoot)\src\**\*;$(ClientRoot)\public\**\*" />
    <ClientSource Include="$(ClientRoot)\index.html;$(ClientRoot)\package.json;$(ClientRoot)\pnpm-lock.yaml;$(ClientRoot)\vite.config.ts;$(ClientRoot)\lingui.config.ts;$(ClientRoot)\tsconfig.json" />

    <!-- Visual Studio's fast up-to-date check only knows project items: without these it would skip the build (and the
         client with it) when only client files changed. -->
    <UpToDateCheckInput Include="@(ClientSource)" Set="Client" />
    <UpToDateCheckOutput Include="$(ClientRoot)\dist\index.html" Set="Client" />
  </ItemGroup>

  <Target Name="InstallClientDependencies" BeforeTargets="Build" Condition="'$(ClientDevBuild)' == 'true'"
          Inputs="$(ClientRoot)\package.json;$(ClientRoot)\pnpm-lock.yaml" Outputs="$(ClientInstallStamp)">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(ClientRoot)" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ClientExitCode" />
    </Exec>
    <Error Condition="'$(ClientExitCode)' == '9009' or '$(ClientExitCode)' == '127'" Text="The client (src/ODC.Client) needs Node.js 24+ and pnpm. Install them, or build with -p:SkipClientBuild=true and serve a client built separately." />
    <Error Condition="'$(ClientExitCode)' != '0'" Text="pnpm install failed in src/ODC.Client (see the output above)." />
    <Touch Files="$(ClientInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildClientForDevelopment" AfterTargets="InstallClientDependencies" Condition="'$(ClientDevBuild)' == 'true'"
          Inputs="@(ClientSource)" Outputs="$(ClientRoot)\dist\index.html">
    <Exec Command="pnpm build" WorkingDirectory="$(ClientRoot)" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ClientExitCode" />
    </Exec>
    <Error Condition="'$(ClientExitCode)' == '9009' or '$(ClientExitCode)' == '127'" Text="The client (src/ODC.Client) needs Node.js 24+ and pnpm. Install them, or build with -p:SkipClientBuild=true and serve a client built separately." />
    <Error Condition="'$(ClientExitCode)' != '0'" Text="The client build failed in src/ODC.Client (see the output above)." />
  </Target>

  <Target Name="BuildClient" BeforeTargets="ComputeResolvedFilesToPublishList" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(ClientRoot)" />
    <Exec Command="pnpm build" WorkingDirectory="$(ClientRoot)" />
  </Target>

  <Target Name="PublishClient" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ClientDist Include="$(ClientRoot)\dist\**" Exclude="$(ClientRoot)\dist\**\*.map" />
      <ResolvedFileToPublish Include="@(ClientDist)" RelativePath="ClientApp\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
