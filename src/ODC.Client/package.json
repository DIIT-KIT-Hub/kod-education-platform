{
  "name": "odc-client",
  "version": "1.0.0",
  "private": true,
  "description": "ODC single-page application (React + Vite), served by ODC.Web.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict --typescript",
    "api:types": "node --use-system-ca ./node_modules/openapi-typescript/bin/cli.js https://localhost:7180/openapi/v1.json --output src/shared/api/schema.d.ts --root-types --root-types-no-schema-prefix"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.107.1",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "lucide-react": "1.70.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@eslint/js": "10.0.1",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
