@page "/news/{Slug}"
@attribute [RequirePermission(Permissions.News.View)]

@if (Article is null)
{
    <PageHeader Title="@T("Новину не знайдено")" Breadcrumbs="@([new(T("Новини"), "/news"), new(T("Новина"))])" />
    <Card>
        <EmptyState Icon="newspaper" Title="@T("Новину не знайдено")" Text="@T("Можливо, її було видалено або знято з публікації.")">
            <Button Href="/news" Icon="arrow-left">@T("До новин")</Button>
        </EmptyState>
    </Card>
}
else
{
    <article class="article">
        <PageHeader Title="@Article.Title" Breadcrumbs="@([new(T("Новини"), "/news"), new(Display.Text(Article.Category), $"/news?category={Article.Category}")])">
            <ChildContent>
                <div class="ds-cluster ds-muted ds-text-sm">
                    <Badge>@Display.Text(Article.Category)</Badge>
                    @if (Article.PublishedAt is null)
                    {
                        <Badge Tone="Tone.Dashed">@T("Чернетка")</Badge>
                    }
                    <span>@Display.Date(Article.PublishedAt ?? Article.UpdatedAt)</span>
                    @if (Article.Organization is { } organization)
                    {
                        <span>·</span>
                        <span>@organization.Name</span>
                    }
                    <span>·</span>
                    <span class="ds-row" title="@T("Переглядів")"><Icon Name="eye" Size="IconSize.Small" />@Article.ViewCount</span>
                </div>
            </ChildContent>
            <Actions>
                @if (CanManage)
                {
                    <Button Href="@($"/news/manage/{Article.Id}")" Variant="ButtonVariant.Secondary" Icon="pencil">@T("Редагувати")</Button>
                }
            </Actions>
        </PageHeader>
        @if (Article.CoverImageUrl is not null)
        {
            <img class="article__cover ds-animate-scale" src="@Article.CoverImageUrl" alt="" fetchpriority="high" />
        }
        <div class="article__byline">
            <PersonName Name="@Article.Author.FullName" PhotoId="@Article.Author.PhotoId" Meta="@T("Автор публікації")" Size="ControlSize.Medium" />
        </div>
        <p class="article__lead">@Article.Summary</p>
        <div class="prose ds-animate-in" data-article-body>@((MarkupString)Article.BodyHtml)</div>
        <hr />
        <NewsDiscussionPanel @rendermode="InteractiveServer" ArticleId="Article.Id" />
        <Button Href="/news" Variant="ButtonVariant.Ghost" Icon="arrow-left">@T("Усі новини")</Button>
    </article>
}
