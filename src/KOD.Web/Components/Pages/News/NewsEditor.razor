@page "/news/manage/new"
@page "/news/manage/{Id:guid}"
@attribute [RequirePermission(Permissions.News.Manage)]
@rendermode InteractiveServer

<PageHeader Title="@(Id is null ? T("Нова публікація") : T("Редагування публікації"))"
            Breadcrumbs="@([new(T("Новини"), "/news"), new(T("Керування"), "/news/manage"), new(Id is null ? T("Нова") : T("Редагування"))])">
    <Actions>
        @if (Existing?.PublishedAt is not null)
        {
            <Button Href="@($"/news/{Existing.Slug}")" Variant="ButtonVariant.Secondary" Icon="eye">@T("Переглянути")</Button>
        }
    </Actions>
</PageHeader>

@if (Loaded)
{
    <EditForm Model="Model" OnValidSubmit="SaveAsync" class="ds-split ds-split--wide-aside">
        <DataAnnotationsValidator />
        <div class="ds-stack ds-stack--lg">
            @if (ErrorMessage is not null)
            {
                <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
            }
            <Card>
                <div class="ds-form">
                    <Field Label="@T("Заголовок")" For="news-title" Required>
                        <InputText id="news-title" @bind-Value="Model.Title" class="ds-input" maxlength="200" />
                        <ValidationError For="() => Model.Title" />
                    </Field>
                    <Field Label="@T("Анонс")" For="news-summary" Required Hint="@T("1–2 речення для картки новини.")">
                        <InputTextArea id="news-summary" @bind-Value="Model.Summary" class="ds-textarea" maxlength="500" rows="3" />
                        <ValidationError For="() => Model.Summary" />
                    </Field>
                    <Field Label="@T("Текст (Markdown)")" For="news-body" Required Hint="@T("Підтримуються заголовки (##), списки, посилання, цитати (>), таблиці. HTML не підтримується з міркувань безпеки.")">
                        <InputTextArea id="news-body" @bind-Value="Model.Body" class="ds-textarea ds-mono" rows="16" />
                        <ValidationError For="() => Model.Body" />
                    </Field>
                </div>
            </Card>
        </div>

        <div class="ds-stack ds-stack--lg">
            <Card Title="@T("Публікація")">
                <div class="ds-form">
                    <Field Label="@T("Організація")" For="news-organization" Hint="@T("Редагувати новину можуть фахівці з комунікацій цієї організації.")">
                        <InputSelect id="news-organization" @bind-Value="Model.OrganizationId" class="ds-select">
                            @if (CabinetWide)
                            {
                                <option value="">@T("Увесь кабінет (усі організації)")</option>
                            }
                            @foreach (var organization in Organizations)
                            {
                                <option value="@organization.Id">@organization.Name</option>
                            }
                        </InputSelect>
                    </Field>
                    <Field Label="@T("Категорія")" For="news-category">
                        <InputSelect id="news-category" @bind-Value="Model.Category" class="ds-select">
                            @foreach (var category in Enum.GetValues<NewsCategory>())
                            {
                                <option value="@category">@Display.Text(category)</option>
                            }
                        </InputSelect>
                    </Field>
                    <label class="ds-check">
                        <InputCheckbox @bind-Value="Model.Publish" />
                        <span class="ds-check__text"><span>@T("Опубліковано")</span><span class="ds-check__hint">@T("Новину бачать усі працівники.")</span></span>
                    </label>
                    <label class="ds-check">
                        <InputCheckbox @bind-Value="Model.IsPinned" />
                        <span class="ds-check__text"><span>@T("Закріпити зверху")</span></span>
                    </label>
                </div>
            </Card>

            <Card Title="@T("Обкладинка")">
                @if (Existing?.CoverImageUrl is not null && !Model.RemoveCover && CoverFile is null)
                {
                    <img class="article__cover" src="@Existing.CoverImageUrl" alt="" />
                    <label class="ds-check">
                        <InputCheckbox @bind-Value="Model.RemoveCover" />
                        <span>@T("Прибрати обкладинку")</span>
                    </label>
                }
                <label class="ds-dropzone">
                    <InputFile OnChange="SelectCover" accept="image/png,image/jpeg,image/webp" />
                    <span class="ds-dropzone__title">@(CoverFile?.Name ?? T("Оберіть зображення"))</span>
                    <span class="ds-dropzone__hint">@T("PNG, JPEG або WebP до 5 МБ, бажано 16:9.")</span>
                </label>
            </Card>

            <Card Variant="CardVariant.Muted">
                <div class="ds-stack">
                    <Button Type="submit" Block Icon="save" Disabled="Busy">@T("Зберегти")</Button>
                    @if (Id is not null)
                    {
                        <Button Variant="ButtonVariant.Danger" Block Icon="trash-2" Disabled="Busy" OnClick="DeleteAsync">@T("Видалити")</Button>
                    }
                </div>
            </Card>
        </div>
    </EditForm>
}
else
{
    <FormSkeleton Cards="2" Fields="2" />
}
