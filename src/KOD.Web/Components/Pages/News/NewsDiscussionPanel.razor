@using KOD.Application.Features.News.Discussion

<section class="discussion" aria-labelledby="discussion-title">
    @if (Discussion is null)
    {
        <CardSkeleton />
    }
    else
    {
        <ReactionBar Summary="Discussion.Reactions" CanReact="Discussion.CanReact" OnReact="kind => ReactAsync(null, kind)" />

        <h2 id="discussion-title" class="discussion__title">
            @T("Коментарі")
            <span class="discussion__count">@Discussion.CommentCount</span>
        </h2>

        @if (ErrorMessage is not null)
        {
            <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
        }

        @if (Discussion.CanComment)
        {
            <div class="comment-form">
                <Avatar Name="@MyName" PhotoId="@MyPhotoId" />
                <div class="comment-form__body">
                    <textarea class="ds-textarea" rows="2" maxlength="@NewsComment.BodyMaxLength" placeholder="@T("Напишіть коментар…")"
                              aria-label="@T("Новий коментар")" @bind="NewComment" @bind:event="oninput"></textarea>
                    <div class="comment-form__actions">
                        <Button Size="ControlSize.Small" Icon="send" Disabled="@(Busy || string.IsNullOrWhiteSpace(NewComment))" OnClick="() => CommentAsync(null)">@T("Надіслати")</Button>
                    </div>
                </div>
            </div>
        }
        else if (Discussion.CanReact)
        {
            <p class="ds-muted ds-text-sm">@T("Коментарі до цієї новини вимкнено.")</p>
        }
        else
        {
            <p class="ds-muted ds-text-sm">@T("Реакції та коментарі з'являться після публікації.")</p>
        }

        @if (Discussion.Comments.Count == 0 && Discussion.CanComment)
        {
            <p class="ds-muted ds-text-sm">@T("Коментарів ще немає. Будьте першими!")</p>
        }

        <ol class="comments">
            @foreach (var comment in Discussion.Comments)
            {
                <li @key="comment.Id">
                    @CommentView(comment)
                    @if (comment.Replies.Count > 0 || ReplyTo == comment.Id)
                    {
                        <ol class="comments comments--replies">
                            @foreach (var reply in comment.Replies)
                            {
                                <li @key="reply.Id">@CommentView(reply)</li>
                            }
                            @if (ReplyTo == comment.Id)
                            {
                                <li class="comment-form comment-form--reply">
                                    <Avatar Name="@MyName" PhotoId="@MyPhotoId" Size="ControlSize.Small" />
                                    <div class="comment-form__body">
                                        <textarea class="ds-textarea" rows="2" maxlength="@NewsComment.BodyMaxLength" placeholder="@T("Ваша відповідь…")"
                                                  aria-label="@T("Відповідь на коментар")" @bind="ReplyText" @bind:event="oninput"></textarea>
                                        <div class="comment-form__actions">
                                            <Button Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="() => ReplyTo = null">@T("Скасувати")</Button>
                                            <Button Size="ControlSize.Small" Icon="send" Disabled="@(Busy || string.IsNullOrWhiteSpace(ReplyText))" OnClick="() => CommentAsync(comment.Id)">@T("Відповісти")</Button>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                </li>
            }
        </ol>

        @if (Discussion.HasMore)
        {
            <Button Variant="ButtonVariant.Secondary" Icon="chevron-down" Disabled="Busy" OnClick="ShowMoreAsync">@T("Попередні коментарі")</Button>
        }
    }
</section>

@code {
    /// <summary>
    /// Renders one comment or reply.
    /// </summary>
    /// <param name="comment">The comment.</param>
    /// <returns>The markup.</returns>
    private RenderFragment CommentView(NewsCommentDto comment) => __builder =>
    {
        <article class="comment @(comment.IsDeleted ? "comment--deleted" : null)">
            <Avatar Name="@comment.Author.FullName" PhotoId="@comment.Author.PhotoId" Size="@(comment.ParentId is null ? ControlSize.Medium : ControlSize.Small)" />
            <div class="comment__body">
                <header class="comment__header">
                    <span class="ds-strong">@comment.Author.FullName</span>
                    <time class="ds-text-xs ds-muted" datetime="@comment.CreatedAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" title="@Display.DateTime(comment.CreatedAt)">@Display.Ago(comment.CreatedAt, Now)</time>
                    @if (comment.EditedAt is not null)
                    {
                        <span class="ds-text-xs ds-muted" title="@Display.DateTime(comment.EditedAt)">@T("(змінено)")</span>
                    }
                </header>
                @if (comment.IsDeleted)
                {
                    <p class="comment__text ds-muted">@T("Коментар видалено.")</p>
                }
                else if (EditingId == comment.Id)
                {
                    <textarea class="ds-textarea" rows="3" maxlength="@NewsComment.BodyMaxLength" aria-label="@T("Текст коментаря")" @bind="EditText" @bind:event="oninput"></textarea>
                    <div class="comment-form__actions">
                        <Button Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="() => EditingId = null">@T("Скасувати")</Button>
                        <Button Size="ControlSize.Small" Icon="save" Disabled="@(Busy || string.IsNullOrWhiteSpace(EditText))" OnClick="() => SaveEditAsync(comment.Id)">@T("Зберегти")</Button>
                    </div>
                }
                else
                {
                    <p class="comment__text">@comment.Body</p>
                    <div class="comment__actions">
                        <ReactionBar Summary="comment.Reactions" CanReact="Discussion!.CanReact" Compact OnReact="kind => ReactAsync(comment.Id, kind)" />
                        @if (Discussion!.CanComment)
                        {
                            <button type="button" class="comment__action" @onclick="() => StartReply(comment)"><Icon Name="reply" Size="IconSize.Small" />@T("Відповісти")</button>
                        }
                        @if (comment.CanEdit)
                        {
                            <button type="button" class="comment__action" @onclick="() => StartEdit(comment)"><Icon Name="pencil" Size="IconSize.Small" />@T("Змінити")</button>
                        }
                        @if (comment.CanDelete)
                        {
                            <button type="button" class="comment__action" @onclick="() => DeleteAsync(comment.Id)"><Icon Name="trash-2" Size="IconSize.Small" />@T("Видалити")</button>
                        }
                    </div>
                }
            </div>
        </article>
    };
}
