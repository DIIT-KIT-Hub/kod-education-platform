@page "/profile/sessions"

<PageHeader Title="@T("Активні сесії")" Subtitle="@T("Пристрої, з яких виконано вхід. Завершіть сесії, яких ви не впізнаєте.")">
    <Actions>
        <form method="post" @formname="revoke-others" @onsubmit="RevokeOthersAsync" data-confirm="@T("Завершити всі інші сесії?")">
            <AntiforgeryToken />
            <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="log-out">@T("Завершити всі інші")</Button>
        </form>
    </Actions>
</PageHeader>
<ProfileTabs Current="sessions" />

<DataGrid TItem="SessionDto" Items="PageItems" Page="CurrentPage" PageSize="Size" TotalCount="Sessions.Count" Caption="@T("Сесії")" EmptyIcon="monitor" EmptyTitle="@T("Активних сесій немає")">
    <Columns>
        <GridColumn TItem="SessionDto" Title="@T("Пристрій")" Primary>
            <div class="ds-row">
                <span class="ds-stat__icon"><Icon Name="@(IsMobile(context.UserAgent) ? "smartphone" : "monitor")" /></span>
                <div class="ds-stack ds-stack--sm">
                    <span class="ds-strong">@DescribeAgent(context.UserAgent)</span>
                    @if (context.IsCurrent)
                    {
                        <Badge Tone="Tone.Inverse" Dot>@T("Поточна сесія")</Badge>
                    }
                </div>
            </div>
        </GridColumn>
        <GridColumn TItem="SessionDto" Title="@T("IP-адреса")"><span class="ds-mono">@(context.IpAddress ?? "—")</span></GridColumn>
        <GridColumn TItem="SessionDto" Title="@T("Вхід")">@Display.DateTime(context.CreatedAt)</GridColumn>
        <GridColumn TItem="SessionDto" Title="@T("Активність")">@Display.DateTime(context.LastSeenAt)</GridColumn>
        <GridColumn TItem="SessionDto" Title="@T("Дії")" Actions>
            @if (!context.IsCurrent)
            {
                <form method="post" @formname="@($"revoke-{context.Id}")" @onsubmit="() => RevokeAsync(context.Id)" data-confirm="@T("Завершити цю сесію?")">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Icon="x">@T("Завершити")</Button>
                </form>
            }
        </GridColumn>
    </Columns>
</DataGrid>
