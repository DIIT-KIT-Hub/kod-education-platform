@page "/profile"

<PageHeader Title="@T("Мій профіль")" Subtitle="@T("Особисті дані, посади та доступні можливості.")" />
<ProfileTabs Current="overview" />

@if (Profile is not null)
{
    <div class="ds-split">
        <div class="ds-stack ds-stack--lg ds-stagger">
            <Card>
                <div class="ds-row ds-row--wrap">
                    <Avatar Name="@Profile.FullName" Size="ControlSize.Large" />
                    <div class="ds-stack ds-stack--sm">
                        <h2 class="ds-card__title">@Profile.FullName</h2>
                        <span class="ds-muted">@Profile.Email</span>
                        <div class="ds-cluster">
                            @if (Profile.TwoFactorEnabled)
                            {
                                <Badge Tone="Tone.Inverse" Icon="shield-check">@T("2FA увімкнено")</Badge>
                            }
                            <Badge Tone="Tone.Dashed">@T("Останній вхід: {0}", Display.DateTime(Profile.LastSignInAt))</Badge>
                        </div>
                    </div>
                </div>
            </Card>

            <Card Title="@T("Посади")">
                @if (Profile.Positions.Count == 0)
                {
                    <EmptyState Icon="briefcase" Title="@T("Посади не призначено")" Text="@T("Зверніться до відділу кадрів.")" />
                }
                else
                {
                    <ul class="ds-list">
                        @foreach (var position in Profile.Positions)
                        {
                            <li>
                                <a class="ds-list__item" href="@($"/structure/{position.UnitId}")">
                                    <span class="ds-stat__icon"><Icon Name="briefcase" /></span>
                                    <span class="ds-list__body">
                                        <span class="ds-list__title">@position.DisplayTitle</span>
                                        <span class="ds-list__meta">@position.UnitName · @T("роль «{0}»", position.RoleName)</span>
                                    </span>
                                    @if (position.IsPrimary)
                                    {
                                        <Badge Tone="Tone.Outline">@T("Основна")</Badge>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }
            </Card>

            <Card Title="@T("Доступні модулі")">
                <div class="ds-cols">
                    @foreach (var module in Profile.Modules)
                    {
                        <div class="ds-row">
                            <span class="ds-stat__icon"><Icon Name="@Display.IconOf(module)" /></span>
                            <span class="ds-strong">@Display.Text(module)</span>
                        </div>
                    }
                </div>
                <details>
                    <summary class="ds-link ds-text-sm">@T("Усі мої дозволи ({0})", Profile.Permissions.Count)</summary>
                    <ul class="ds-list">
                        @foreach (var permission in Profile.Permissions)
                        {
                            <li class="ds-list__item">
                                <Icon Name="check" Size="IconSize.Small" />
                                <span class="ds-list__body">
                                    <span class="ds-list__title">@permission.Title</span>
                                    <span class="ds-list__meta">@permission.Description</span>
                                </span>
                            </li>
                        }
                    </ul>
                </details>
            </Card>
        </div>

        <div class="ds-stack ds-stack--lg">
            <Card Title="@T("Контакти")">
                @if (Saved)
                {
                    <Alert Tone="Tone.Inverse">@T("Телефон збережено.")</Alert>
                }
                @if (ErrorMessage is not null)
                {
                    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
                }
                <EditForm Model="Contact" FormName="profile-contact" OnValidSubmit="SaveAsync" class="ds-form" Enhance>
                    <DataAnnotationsValidator />
                    <Field Label="@T("Електронна пошта")">
                        <input class="ds-input" value="@Profile.Email" disabled />
                    </Field>
                    <Field Label="@T("Телефон")" For="profile-phone">
                        <InputText id="profile-phone" @bind-Value="Contact.PhoneNumber" class="ds-input" placeholder="+380…" autocomplete="tel" />
                        <ValidationError For="() => Contact.PhoneNumber" />
                    </Field>
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="save">@T("Зберегти")</Button>
                </EditForm>
                <p class="ds-text-sm ds-muted">@T("ПІБ та посади змінює відділ кадрів.")</p>
            </Card>

            @* A plain (not enhanced) form: the new language needs a full page load. *@
            <Card Title="@T("Мова інтерфейсу")">
                <form method="post" action="/account/language" class="ds-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="/profile" />
                    <div class="ds-segmented" role="radiogroup" aria-label="@T("Мова інтерфейсу")">
                        @foreach (var language in Languages.All)
                        {
                            <label class="ds-segmented__option">
                                <input type="radio" name="language" value="@language" checked="@(language == Languages.Current)" />
                                <span class="ds-segmented__label" lang="@language">
                                    @Languages.NativeName(language)
                                    <small>@language.ToUpperInvariant()</small>
                                </span>
                            </label>
                        }
                    </div>
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="languages">@T("Застосувати")</Button>
                </form>
                <p class="ds-text-sm ds-muted">@T("Мова зберігається у профілі й застосовується на всіх ваших пристроях.")</p>
            </Card>
        </div>
    </div>
}
