@page "/profile/security"

<PageHeader Title="@T("Безпека")" Subtitle="@T("Пароль, двофакторна автентифікація, резервні коди та входи на інших пристроях.")" />
<ProfileTabs Current="security" />

@if (Profile is not null)
{
    <div class="ds-cols ds-stagger">
        <Card Title="@T("Пароль")" Subtitle="@T("Регулярно змінюйте пароль і не використовуйте його в інших сервісах.")">
            <Footer>
                <Button Href="/account/change-password?returnUrl=%2Fprofile%2Fsecurity" Icon="key-round">@T("Змінити пароль")</Button>
            </Footer>
        </Card>

        <Card Title="@T("Двофакторна автентифікація")" Subtitle="@T("Код із застосунку-автентифікатора при кожному вході.")">
            <div class="ds-cluster">
                @if (Profile.TwoFactorEnabled)
                {
                    <Badge Tone="Tone.Inverse" Icon="shield-check">@T("Увімкнено")</Badge>
                }
                else
                {
                    <Badge Tone="Tone.Danger" Icon="shield-alert">@T("Не налаштовано")</Badge>
                }
            </div>
            <p class="ds-text-sm ds-muted">@T("Змінили телефон? Попросіть адміністратора скинути автентифікатор — під час наступного входу ви прив'яжете новий.")</p>
        </Card>

        <Card Title="@T("Резервні коди")" Subtitle="@T("Для входу без телефону. Кожен код діє один раз.")">
            <ChildContent>
                <p><span class="ds-stat__value">@Profile.RecoveryCodesLeft</span> <span class="ds-muted">@T("кодів залишилось")</span></p>
                @if (ErrorMessage is not null)
                {
                    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
                }
                @if (Codes is not null)
                {
                    <div class="secret-box">
                        <span class="ds-strong">@T("Нові коди — збережіть їх зараз, вони більше не відображатимуться:")</span>
                        <ul class="ds-codes">
                            @foreach (var recoveryCode in Codes)
                            {
                                <li>@recoveryCode</li>
                            }
                        </ul>
                        <button type="button" class="ds-btn ds-btn--secondary ds-btn--sm" data-copy="@string.Join(Environment.NewLine, Codes)"><Icon Name="copy" /> <span>@T("Скопіювати")</span></button>
                    </div>
                }
            </ChildContent>
            <Footer>
                @* Step-up: a valid session alone is not enough to replace the recovery codes. *@
                <form method="post" @formname="regenerate-codes" @onsubmit="RegenerateAsync" class="ds-row ds-row--wrap" data-confirm="@T("Згенерувати нові коди? Старі перестануть діяти.")">
                    <AntiforgeryToken />
                    <OtpInput>
                        <input name="StepUpCode" class="ds-input ds-otp__input" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required
                               aria-label="@T("Код із застосунку-автентифікатора")" />
                    </OtpInput>
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="refresh-cw">@T("Нові коди")</Button>
                </form>
            </Footer>
        </Card>

        <Card Title="@T("Інші пристрої")" Subtitle="@T("Залишили вхід на чужому комп'ютері або загубили телефон? Завершіть усі входи, крім цього браузера.")">
            <ChildContent>
                <p class="ds-text-sm ds-muted">@T("Інші пристрої втратять доступ протягом кількох хвилин — щойно закінчиться строк їхнього токена доступу.")</p>
            </ChildContent>
            <Footer>
                <form method="post" @formname="sign-out-everywhere" @onsubmit="SignOutEverywhereAsync" data-confirm="@T("Вийти на всіх інших пристроях?")">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="log-out">@T("Вийти на інших пристроях")</Button>
                </form>
            </Footer>
        </Card>
    </div>
}
