@page "/structure"
@attribute [RequirePermission(Permissions.Structure.View)]

<PageHeader Title="@T("Структура")" Subtitle="@T("Організації, їхні підрозділи та працівники.")">
    <Actions>
        @if (CanManage)
        {
            <Button Href="/admin/units" Variant="ButtonVariant.Secondary" Icon="settings">@T("Керувати структурою")</Button>
            @if (CanCreateOrganization)
            {
                <Button Href="/admin/units/new?top=true" Icon="plus">@T("Нова організація")</Button>
            }
        }
    </Actions>
</PageHeader>

<Card>
    @if (Tree.Count == 0)
    {
        <EmptyState Icon="network" Title="@T("Структуру ще не заповнено")" />
    }
    else
    {
        <ul class="ds-tree ds-stagger">
            @foreach (var node in Tree)
            {
                <UnitTreeBranch Node="node" Expanded />
            }
        </ul>
    }
</Card>
