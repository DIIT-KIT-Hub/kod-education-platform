@if (Permissions.Count == 0)
{
    <Badge Tone="Tone.Dashed" Icon="users">@T("Для всіх користувачів")</Badge>
}
else if (IsAvailable)
{
    <Badge Tone="Tone.Inverse" Icon="circle-check">@T("Доступно вам")</Badge>
}
else
{
    <Badge Tone="Tone.Outline" Icon="lock" Title="@RequiredFullText">@T("Потрібен дозвіл: {0}", RequiredText)</Badge>
}
