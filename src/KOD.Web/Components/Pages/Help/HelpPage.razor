@page "/help"
@using KOD.Web.Components.Pages.Help.Chapters

<PageTitle>Довідка · КОД</PageTitle>

<div class="ds-stack ds-stack--lg" data-help>
    <PageHeader Title="Довідка" Subtitle="Інструкція користувача Кабінету освітніх даних: усі модулі, можливості та покрокові дії.">
        <Actions>
            <button type="button" class="ds-btn ds-btn--secondary" data-help-print>
                <Icon Name="file-down" /> <span>Друк / PDF</span>
            </button>
        </Actions>
    </PageHeader>

    <div class="help-search" role="search">
        <label class="ds-visually-hidden" for="help-search">Пошук у довідці</label>
        <div class="help-search__field">
            <Icon Name="search" />
            <input id="help-search" class="ds-input" type="search" placeholder="Пошук у довідці: наприклад, «підпис», «пароль», «імпорт»" autocomplete="off" data-help-search />
        </div>
        <p class="help-search__status" aria-live="polite" data-help-search-status></p>
    </div>

    <div class="help-layout">
        <details class="help-toc" open>
            <summary><Icon Name="list" /> Зміст <Icon Name="chevron-down" Class="help-toc__chevron" /></summary>
            <nav aria-label="Зміст довідки">
                <ol>
                    @foreach (var (chapter, number) in HelpContents.Chapters.Select(static (c, i) => (c, i + 1)))
                    {
                        <li class="help-toc__chapter" data-target="@chapter.Id">
                            <a href="@($"/help#{chapter.Id}")"><span class="help-toc__number">@number.</span> <span>@chapter.Title</span></a>
                            <ol>
                                @foreach (var (topic, index) in chapter.Topics.Select(static (t, i) => (t, i + 1)))
                                {
                                    <li data-target="@topic.Id">
                                        <a href="@($"/help#{topic.Id}")"><span class="help-toc__number">@number.@index</span> <span>@topic.Title</span></a>
                                    </li>
                                }
                            </ol>
                        </li>
                    }
                </ol>
            </nav>
        </details>

        <div class="help-content">
            <GettingStartedChapter />
            <AccountChapter />
            <HomeChapter />
            <DocumentsChapter />
            <SigningChapter />
            <NewsChapter />
            <StructureChapter />
            <ProfileChapter />
            <AdministrationChapter />
            <RolesChapter />
            <FaqChapter />
        </div>
    </div>
</div>
