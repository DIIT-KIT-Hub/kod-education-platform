@page "/help"
@using KOD.Web.Components.Pages.Help.Chapters

<PageTitle>@T("Довідка · КОД")</PageTitle>

<div class="ds-stack ds-stack--lg" data-help>
    <PageHeader Title="@T("Довідка")" Subtitle="@T("Інструкція користувача Кабінету організаційних документів: усі модулі, можливості та покрокові дії.")">
        <Actions>
            <button type="button" class="ds-btn ds-btn--secondary" data-help-print>
                <Icon Name="file-down" /> <span>@T("Друк / PDF")</span>
            </button>
        </Actions>
    </PageHeader>

    <div class="help-search" role="search">
        <label class="ds-visually-hidden" for="help-search">@T("Пошук у довідці")</label>
        <div class="help-search__field">
            <Icon Name="search" />
            <input id="help-search" class="ds-input" type="search" placeholder="@T("Пошук у довідці: наприклад, «підпис», «пароль», «імпорт»")" autocomplete="off" data-help-search />
        </div>
        <p class="help-search__status" aria-live="polite" data-help-search-status></p>
    </div>

    <div class="help-layout">
        <details class="help-toc" open>
            <summary><Icon Name="list" /> @T("Зміст") <Icon Name="chevron-down" Class="help-toc__chevron" /></summary>
            <nav aria-label="@T("Зміст довідки")">
                <ol>
                    @foreach (var (chapter, number) in HelpContents.Chapters.Select(static (c, i) => (c, i + 1)))
                    {
                        <li class="help-toc__chapter" data-target="@chapter.Id">
                            <a href="@($"/help#{chapter.Id}")"><span class="help-toc__number">@number.</span> <span>@In("help", chapter.Title)</span></a>
                            <ol>
                                @foreach (var (topic, index) in chapter.Topics.Select(static (t, i) => (t, i + 1)))
                                {
                                    <li data-target="@topic.Id">
                                        <a href="@($"/help#{topic.Id}")"><span class="help-toc__number">@number.@index</span> <span>@In("help", topic.Title)</span></a>
                                    </li>
                                }
                            </ol>
                        </li>
                    }
                </ol>
            </nav>
        </details>

        <div class="help-content">
            @if (Languages.Current == Languages.English)
            {
                <KOD.Web.Components.Pages.Help.Chapters.English.GettingStartedChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.AccountChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.HomeChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.DocumentsChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.SigningChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.NewsChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.StructureChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.ProfileChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.AdministrationChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.RolesChapter />
                <KOD.Web.Components.Pages.Help.Chapters.English.FaqChapter />
            }
            else
            {
                <GettingStartedChapter />
                <AccountChapter />
                <HomeChapter />
                <DocumentsChapter />
                <SigningChapter />
                <NewsChapter />
                <StructureChapter />
                <ProfileChapter />
                <AdministrationChapter />
                <RolesChapter />
                <FaqChapter />
            }
        </div>
    </div>
</div>
