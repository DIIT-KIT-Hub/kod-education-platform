<section class="help-chapter" id="@Chapter.Id" aria-labelledby="@($"{Chapter.Id}-title")" data-help-chapter>
    <header class="help-chapter__header">
        <span class="help-chapter__icon"><Icon Name="@Chapter.Icon" Size="IconSize.Large" /></span>
        <div class="help-chapter__heading">
            <span class="help-chapter__number">Розділ @Number</span>
            <h2 id="@($"{Chapter.Id}-title")" class="help-chapter__title">@Chapter.Title</h2>
            <p class="ds-muted">@Chapter.Summary</p>
            <div class="ds-cluster"><HelpAccess Permissions="Chapter.Permissions" /></div>
        </div>
    </header>
    @ChildContent
</section>
