<section class="help-topic" id="@Topic.Id" aria-labelledby="@($"{Topic.Id}-title")" data-help-topic>
    <h3 id="@($"{Topic.Id}-title")" class="help-topic__title">
        <a class="help-topic__anchor" href="@($"/help#{Topic.Id}")" aria-label="@T("Посилання на розділ «{0}»", In("help", Topic.Title))"><Icon Name="link" /></a>
        <span>@In("help", Topic.Title)</span>
    </h3>
    @if (Topic.Permissions.Count > 0)
    {
        <div class="ds-cluster"><HelpAccess Permissions="Topic.Permissions" /></div>
    }
    <div class="help-prose">
        @ChildContent
    </div>
</section>
