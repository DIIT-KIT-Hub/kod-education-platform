@page "/admin"
@attribute [RequirePermission(Permissions.Users.View, Permissions.Roles.Manage, Permissions.Structure.Manage, Permissions.News.Manage, Permissions.Audit.View)]

<PageHeader Title="Адміністрування" Subtitle="Облікові записи, ролі, структура закладу та журнал подій." />

<div class="ds-cols ds-stagger">
    @foreach (var section in Sections.Where(s => User.HasAnyPermission([.. s.Permissions])))
    {
        <Card Href="@section.Href">
            <div class="ds-stack">
                <div class="ds-row ds-row--between">
                    <span class="ds-stat__icon"><Icon Name="@section.Icon" /></span>
                    <Icon Name="arrow-right" Class="ds-muted" />
                </div>
                <span class="ds-card__title">@section.Title</span>
                <span class="ds-muted ds-text-sm">@section.Description</span>
            </div>
        </Card>
    }
</div>
