@page "/admin/users/new"
@page "/admin/users/{Id:guid}"
@attribute [RequirePermission(Permissions.Users.View)]
@rendermode InteractiveServer

<PageHeader Title="@(Details?.FullName ?? T("Новий користувач"))"
            Subtitle="@(Details is null ? T("Обліковий запис створюється з тимчасовим паролем; під час першого входу користувач змінить його та прив'яже автентифікатор.") : Details.Email)"
            Breadcrumbs="@([new(T("Адміністрування"), "/admin"), new(T("Користувачі"), "/admin/users"), new(Details is null ? T("Новий") : T("Обліковий запис"))])">
    <ChildContent>
        @if (Details is not null)
        {
            <div class="ds-cluster">
                <Avatar Name="@Details.FullName" PhotoId="@Details.PhotoId" />
                @if (Details.PhotoId is null)
                {
                    <Badge Tone="Tone.Dashed" Icon="camera">@T("Без фото")</Badge>
                }
                @if (Details.IsActive)
                {
                    <Badge Tone="Tone.Inverse">@T("Активний")</Badge>
                }
                else
                {
                    <Badge Tone="Tone.Danger" Icon="ban">@T("Заблоковано")</Badge>
                }
                <Badge Tone="@(Details.TwoFactorEnabled ? Tone.Outline : Tone.Dashed)" Icon="shield-check">@(Details.TwoFactorEnabled ? T("2FA увімкнено") : T("2FA не налаштовано"))</Badge>
                @if (Details.MustChangePassword)
                {
                    <Badge Tone="Tone.Dashed" Icon="key-round">@T("Тимчасовий пароль")</Badge>
                }
                <Badge Tone="Tone.Dashed">@T("Сесій: {0}", Details.ActiveSessions)</Badge>
            </div>
        }
    </ChildContent>
</PageHeader>

@if (!Loaded)
{
    <FormSkeleton Cards="3" Fields="4" />
}
else
{
    @if (Credentials is not null)
    {
        <div class="secret-box" style="margin-bottom:1.5rem">
            <span class="ds-strong">@T("Тимчасовий пароль для {0} (показується один раз):", Credentials.Email)</span>
            <span class="secret-box__value">@Credentials.TemporaryPassword</span>
            <div class="ds-cluster">
                <button type="button" class="ds-btn ds-btn--secondary ds-btn--sm" data-copy="@(T("Логін: {0}", Credentials.Email) + "\n" + T("Тимчасовий пароль: {0}", Credentials.TemporaryPassword))"><Icon Name="copy" /> <span>@T("Скопіювати")</span></button>
                <span class="ds-text-sm ds-muted">@T("Передайте його користувачу захищеним каналом. Під час першого входу пароль потрібно змінити.")</span>
            </div>
        </div>
    }

    @if (Message is not null)
    {
        <Alert Tone="Tone.Inverse">@Message</Alert>
    }
    @if (ErrorMessage is not null)
    {
        <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
    }
    @if (CanEditPositions && !CanEditAccount)
    {
        <Alert Tone="Tone.Outline" Icon="info" Title="@T("Обліковий запис кількох організацій")">@T("Користувач також обіймає посади в організаціях, якими ви не керуєте. Ви можете змінювати лише його посади у своїх організаціях; особисті дані, e-mail, статус і безпеку облікового запису змінює адміністратор, що керує всіма його організаціями.")</Alert>
    }

    <EditForm Model="Model" OnValidSubmit="SaveAsync" class="ds-split ds-split--wide-aside">
        <DataAnnotationsValidator />
        <div class="ds-stack ds-stack--lg">
            <Card Title="@T("Особисті дані")">
                <fieldset disabled="@(!CanEditAccount)" class="ds-form-grid" style="border:0;padding:0;margin:0">
                    <Field Label="@T("Прізвище")" For="u-last" Required>
                        <InputText id="u-last" @bind-Value="Model.LastName" class="ds-input" maxlength="64" />
                        <ValidationError For="() => Model.LastName" />
                    </Field>
                    <Field Label="@T("Ім'я")" For="u-first" Required>
                        <InputText id="u-first" @bind-Value="Model.FirstName" class="ds-input" maxlength="64" />
                        <ValidationError For="() => Model.FirstName" />
                    </Field>
                    <Field Label="@T("По батькові")" For="u-middle">
                        <InputText id="u-middle" @bind-Value="Model.MiddleName" class="ds-input" maxlength="64" />
                    </Field>
                    <Field Label="@T("Телефон")" For="u-phone">
                        <InputText id="u-phone" @bind-Value="Model.PhoneNumber" class="ds-input" maxlength="32" placeholder="+380…" />
                    </Field>
                    <Field Label="@T("Електронна пошта (логін)")" For="u-email" Required Class="ds-span-full">
                        <InputText id="u-email" @bind-Value="Model.Email" class="ds-input" maxlength="256" inputmode="email" />
                        <ValidationError For="() => Model.Email" />
                    </Field>
                </fieldset>
            </Card>

            <Card Title="@T("Посади")" Subtitle="@T("Роль посади визначає дозволи; підрозділ — область доступу до документів і організацію, у якій діють адміністративні дозволи ролі.")">
                <HeaderActions>
                    @if (CanEditPositions)
                    {
                        <Button Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Icon="plus" OnClick="AddPosition">@T("Додати посаду")</Button>
                    }
                </HeaderActions>
                <ChildContent>
                    @if (Model.Positions.Count == 0)
                    {
                        <EmptyState Icon="briefcase" Title="@T("Посад не призначено")" Text="@T("Без посади користувач не матиме доступу до модулів.")" />
                    }
                    @foreach (var position in Model.Positions.Where(static p => !p.IsManaged))
                    {
                        <div class="position-row position-row--readonly" @key="position">
                            <Field Label="@T("Посада в іншій організації")" Hint="@T("Змінює адміністратор цієї організації.")">
                                <span class="ds-input" aria-readonly="true">@(position.Title ?? "—") (@position.Description)</span>
                            </Field>
                            <label class="ds-check">
                                <input type="radio" name="primary-position" checked="@position.IsPrimary" disabled />
                                <span>@T("Основна")</span>
                            </label>
                        </div>
                    }
                    @foreach (var position in Model.Positions.Where(static p => p.IsManaged))
                    {
                        <div class="position-row" @key="position">
                            <Field Label="@T("Підрозділ")">
                                <select class="ds-select" disabled="@(!CanEditPositions)" value="@position.UnitId" @onchange="e => position.UnitId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty">
                                    <option value="@Guid.Empty">@T("Оберіть…")</option>
                                    @foreach (var unit in Units)
                                    {
                                        <option value="@unit.Id">@(new string(' ', unit.Depth * 2))@unit.Name</option>
                                    }
                                </select>
                            </Field>
                            <Field Label="@T("Роль")">
                                <select class="ds-select" disabled="@(!CanEditPositions)" value="@position.RoleId" @onchange="e => position.RoleId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty">
                                    <option value="@Guid.Empty">@T("Оберіть…")</option>
                                    @foreach (var role in Roles)
                                    {
                                        <option value="@role.Id">@role.Name</option>
                                    }
                                </select>
                            </Field>
                            <Field Label="@T("Назва посади")">
                                <input class="ds-input" disabled="@(!CanEditPositions)" value="@position.Title" @onchange="e => position.Title = e.Value?.ToString()" placeholder="@T("напр. доцент")" maxlength="128" />
                            </Field>
                            <label class="ds-check">
                                <input type="radio" name="primary-position" checked="@position.IsPrimary" disabled="@(!CanEditPositions || PrimaryIsForeign)" @onchange="() => SetPrimary(position)" />
                                <span>@T("Основна")</span>
                            </label>
                            @if (CanEditPositions)
                            {
                                <button type="button" class="ds-btn ds-btn--ghost ds-btn--icon ds-btn--sm" aria-label="@T("Прибрати посаду")" @onclick="() => RemovePosition(position)"><Icon Name="trash-2" /></button>
                            }
                        </div>
                    }
                </ChildContent>
            </Card>

            @if (CanManageRoles && CanEditAccount)
            {
                <Card Title="@T("Індивідуальні дозволи")" Subtitle="@T("Надати або заборонити окремі дозволи поверх ролей посад.")">
                    <div class="perm-matrix">
                        @foreach (var group in Permissions.All.GroupBy(static p => p.Module))
                        {
                            <section class="perm-module">
                                <span class="perm-module__title"><Icon Name="@Display.IconOf(group.Key)" /> @Display.Text(group.Key)</span>
                                <div class="perm-module__items">
                                    @foreach (var permission in group)
                                    {
                                        <Field Label="@permission.Title" Hint="@(Effective.Contains(permission.Code) ? T("діє зараз") : null)">
                                            <select class="ds-select ds-select--sm" value="@OverrideOf(permission.Code)" @onchange="e => SetOverride(permission.Code, e.Value?.ToString())">
                                                <option value="inherit">@T("За ролями")</option>
                                                <option value="grant">@T("Надати")</option>
                                                <option value="deny">@T("Заборонити")</option>
                                            </select>
                                        </Field>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </Card>
            }
        </div>

        <div class="ds-stack ds-stack--lg">
            @if (CanEditAccount || CanEditPositions)
            {
                <Card Variant="CardVariant.Muted">
                    <div class="ds-stack">
                        <Button Type="submit" Block Icon="save" Disabled="Busy">@(Id is null ? T("Створити обліковий запис") : T("Зберегти зміни"))</Button>
                        @if (Busy)
                        {
                            <div class="ds-progress ds-progress--indeterminate"><div class="ds-progress__bar"></div></div>
                        }
                    </div>
                </Card>
            }

            @if (Details is not null)
            {
                <Card Title="@T("Безпека облікового запису")">
                    <div class="ds-stack">
                        @if (CanManage && Details.CanEditAccount)
                        {
                            <Button Variant="@(Details.IsActive ? ButtonVariant.Danger : ButtonVariant.Primary)" Block Icon="@(Details.IsActive ? "ban" : "check")" Disabled="Busy" OnClick="ToggleActiveAsync">
                                @(Details.IsActive ? T("Заблокувати") : T("Розблокувати"))
                            </Button>
                        }
                        @if (CanSecurity && Details.CanManageSecurity)
                        {
                            <Button Variant="ButtonVariant.Secondary" Block Icon="key-round" Disabled="Busy" OnClick="ResetPasswordAsync">@T("Видати тимчасовий пароль")</Button>
                            <Button Variant="ButtonVariant.Secondary" Block Icon="smartphone" Disabled="Busy" OnClick="ResetAuthenticatorAsync">@T("Скинути автентифікатор")</Button>
                            <Button Variant="ButtonVariant.Secondary" Block Icon="log-out" Disabled="Busy" OnClick="RevokeSessionsAsync">@T("Завершити всі сесії")</Button>
                        }
                    </div>
                    <dl class="ds-dl">
                        <dt>@T("Створено")</dt>
                        <dd>@Display.DateTime(Details.CreatedAt)</dd>
                        <dt>@T("Останній вхід")</dt>
                        <dd>@Display.DateTime(Details.LastSignInAt)</dd>
                    </dl>
                </Card>
            }
        </div>
    </EditForm>
}
