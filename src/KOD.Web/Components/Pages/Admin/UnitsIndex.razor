@page "/admin/units"
@attribute [RequirePermission(Permissions.Structure.Manage)]
@attribute [StreamRendering]

<PageHeader Title="Організації та підрозділи" Subtitle="Організації верхнього рівня та всі їхні підрозділи."
            Breadcrumbs="@([new("Адміністрування", "/admin"), new("Структура")])">
    <Actions>
        <Button Href="/structure" Variant="ButtonVariant.Secondary" Icon="network">Дерево</Button>
        <Button Href="/admin/unit-types" Variant="ButtonVariant.Secondary" Icon="layers">Типи підрозділів</Button>
        <Button Href="/admin/units/new?top=true" Variant="ButtonVariant.Secondary" Icon="building-2">Нова організація</Button>
        <Button Href="/admin/units/new" Icon="plus">Новий підрозділ</Button>
    </Actions>
</PageHeader>

<GridToolbar Search="@Search" Placeholder="Назва або код">
    @if (Organizations.Count > 1)
    {
        <select name="organization" class="ds-select" aria-label="Організація" data-autosubmit>
            <option value="">Усі організації</option>
            @foreach (var organization in Organizations)
            {
                <option value="@organization.Id" selected="@(organization.Id == Organization)">@organization.Name</option>
            }
        </select>
    }
    <select name="type" class="ds-select" aria-label="Тип" data-autosubmit>
        <option value="">Усі типи</option>
        @foreach (var type in Types)
        {
            <option value="@type.Id" selected="@(type.Id == Type)">@type.Name</option>
        }
    </select>
</GridToolbar>

@if (Result is not null)
{
    <DataGrid TItem="UnitListItem" Items="Result.Items" Page="Result.Page" PageSize="Result.PageSize" TotalCount="Result.TotalCount"
              SortBy="@SortBy" Descending="Descending" Caption="Підрозділи" EmptyIcon="network">
        <Columns>
            <GridColumn TItem="UnitListItem" Title="Назва" SortKey="name" Primary>
                <a class="ds-table__primary" href="@($"/admin/units/{context.Id}")">@context.Name</a>
                <span class="ds-table__secondary">@(context.ParentName ?? "Організація верхнього рівня")</span>
            </GridColumn>
            <GridColumn TItem="UnitListItem" Title="Код" SortKey="code"><span class="ds-mono">@context.Code</span></GridColumn>
            <GridColumn TItem="UnitListItem" Title="Тип" SortKey="type">
                <span class="ds-row"><Icon Name="@context.Type.Icon" Size="IconSize.Small" /> @context.Type.Name</span>
            </GridColumn>
            <GridColumn TItem="UnitListItem" Title="Працівників">@context.StaffCount</GridColumn>
            <GridColumn TItem="UnitListItem" Title="Статус">
                @if (context.IsActive)
                {
                    <Badge Tone="Tone.Outline">Активний</Badge>
                }
                else
                {
                    <Badge Tone="Tone.Dashed">Неактивний</Badge>
                }
            </GridColumn>
            <GridColumn TItem="UnitListItem" Title="Дії" Actions>
                <Button Href="@($"/admin/units/{context.Id}")" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Icon="pencil">Редагувати</Button>
            </GridColumn>
        </Columns>
    </DataGrid>
}
