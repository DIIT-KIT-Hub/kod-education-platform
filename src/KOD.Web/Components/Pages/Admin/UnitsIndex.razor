@page "/admin/units"
@attribute [RequirePermission(Permissions.Structure.Manage)]
@attribute [StreamRendering]

<PageHeader Title="@T("Організації та підрозділи")" Subtitle="@(CabinetWide ? T("Усі організації кабінету та їхні підрозділи.") : T("Організації, структурою яких ви керуєте, та їхні підрозділи."))"
            Breadcrumbs="@([new(T("Адміністрування"), "/admin"), new(T("Структура"))])">
    <Actions>
        <Button Href="/structure" Variant="ButtonVariant.Secondary" Icon="network">@T("Дерево")</Button>
        <Button Href="/admin/unit-types" Variant="ButtonVariant.Secondary" Icon="layers">@T("Типи підрозділів")</Button>
        @if (CabinetWide)
        {
            <Button Href="/admin/units/new?top=true" Variant="ButtonVariant.Secondary" Icon="building-2">@T("Нова організація")</Button>
        }
        <Button Href="/admin/units/new" Icon="plus">@T("Новий підрозділ")</Button>
    </Actions>
</PageHeader>

<GridToolbar Search="@Search" Placeholder="@T("Назва або код")">
    @if (Organizations.Count > 1)
    {
        <select name="organization" class="ds-select" aria-label="@T("Організація")" data-autosubmit>
            <option value="">@T("Усі організації")</option>
            @foreach (var organization in Organizations)
            {
                <option value="@organization.Id" selected="@(organization.Id == Organization)">@organization.Name</option>
            }
        </select>
    }
    <select name="type" class="ds-select" aria-label="@T("Тип")" data-autosubmit>
        <option value="">@T("Усі типи")</option>
        @foreach (var type in Types)
        {
            <option value="@type.Id" selected="@(type.Id == Type)">@type.Name</option>
        }
    </select>
</GridToolbar>

@if (Result is not null)
{
    <DataGrid TItem="UnitListItem" Items="Result.Items" Page="Result.Page" PageSize="Result.PageSize" TotalCount="Result.TotalCount"
              SortBy="@SortBy" Descending="Descending" Caption="@T("Підрозділи")" EmptyIcon="network">
        <Columns>
            <GridColumn TItem="UnitListItem" Title="@T("Назва")" SortKey="name" Primary>
                <a class="ds-table__primary" href="@($"/admin/units/{context.Id}")">@context.Name</a>
                <span class="ds-table__secondary">@(context.ParentName ?? T("Організація верхнього рівня"))</span>
            </GridColumn>
            <GridColumn TItem="UnitListItem" Title="@T("Код")" SortKey="code"><span class="ds-mono">@context.Code</span></GridColumn>
            <GridColumn TItem="UnitListItem" Title="@T("Тип")" SortKey="type">
                <span class="ds-row"><Icon Name="@context.Type.Icon" Size="IconSize.Small" /> @context.Type.Name</span>
            </GridColumn>
            <GridColumn TItem="UnitListItem" Title="@T("Працівників")">@context.StaffCount</GridColumn>
            <GridColumn TItem="UnitListItem" Title="@T("Статус")">
                @if (context.IsActive)
                {
                    <Badge Tone="Tone.Outline">@T("Активний")</Badge>
                }
                else
                {
                    <Badge Tone="Tone.Dashed">@T("Неактивний")</Badge>
                }
            </GridColumn>
            <GridColumn TItem="UnitListItem" Title="@T("Дії")" Actions>
                <Button Href="@($"/admin/units/{context.Id}")" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Icon="pencil">@T("Редагувати")</Button>
            </GridColumn>
        </Columns>
    </DataGrid>
}
else
{
    <GridSkeleton Columns="6" />
}
