@page "/admin/users"
@attribute [RequirePermission(Permissions.Users.View)]
@attribute [StreamRendering]

<PageHeader Title="@T("Користувачі")" Subtitle="@(User.HasPermission(Permissions.Administration.AllOrganizations) ? T("Облікові записи працівників і зовнішніх користувачів усіх організацій кабінету. Самостійна реєстрація вимкнена.") : T("Облікові записи працівників і зовнішніх користувачів ваших організацій. Самостійна реєстрація вимкнена."))"
            Breadcrumbs="@([new(T("Адміністрування"), "/admin"), new(T("Користувачі"))])">
    <Actions>
        @if (User.HasPermission(Permissions.Users.Export))
        {
            <Button Href="@ExportHref("Xlsx")" Variant="ButtonVariant.Secondary" Icon="download" download>XLSX</Button>
            <Button Href="@ExportHref("Csv")" Variant="ButtonVariant.Secondary" Icon="download" download>CSV</Button>
        }
        @if (User.HasPermission(Permissions.Users.Import))
        {
            <Button Href="/admin/users/import" Variant="ButtonVariant.Secondary" Icon="upload">@T("Імпорт")</Button>
        }
        @if (User.HasPermission(Permissions.Users.Manage))
        {
            <Button Href="/admin/users/new" Icon="user-plus">@T("Додати")</Button>
        }
    </Actions>
</PageHeader>

<GridToolbar Search="@Search" Placeholder="@T("ПІБ або e-mail")">
    <select name="status" class="ds-select" aria-label="@T("Статус")" data-autosubmit>
        @foreach (var status in Enum.GetValues<UserStatusFilter>())
        {
            <option value="@status" selected="@(status.ToString() == Status)">@Display.Text(status)</option>
        }
    </select>
    <select name="unitId" class="ds-select" aria-label="@T("Підрозділ")" data-autosubmit>
        <option value="">@T("Усі підрозділи")</option>
        @foreach (var unit in Units)
        {
            <option value="@unit.Id" selected="@(unit.Id == UnitId)">@(new string(' ', unit.Depth * 2))@unit.Name</option>
        }
    </select>
    <select name="roleId" class="ds-select" aria-label="@T("Роль")" data-autosubmit>
        <option value="">@T("Усі ролі")</option>
        @foreach (var role in Roles)
        {
            <option value="@role.Id" selected="@(role.Id == RoleId)">@role.Name</option>
        }
    </select>
</GridToolbar>

@if (Result is not null)
{
    <DataGrid TItem="UserListItem" Items="Result.Items" Page="Result.Page" PageSize="Result.PageSize" TotalCount="Result.TotalCount"
              SortBy="@SortBy" Descending="Descending" Caption="@T("Користувачі")" EmptyIcon="users" EmptyTitle="@T("Користувачів не знайдено")">
        <Columns>
            <GridColumn TItem="UserListItem" Title="@T("Користувач")" SortKey="name" Primary>
                <div class="ds-row">
                    <Avatar Name="@context.FullName" Size="ControlSize.Small" />
                    <div class="ds-stack ds-stack--sm" style="gap:0">
                        <a class="ds-table__primary" href="@($"/admin/users/{context.Id}")">@context.FullName</a>
                        <span class="ds-table__secondary">@context.Email</span>
                    </div>
                </div>
            </GridColumn>
            <GridColumn TItem="UserListItem" Title="@T("Посада")">
                @(context.Position ?? "—")
                @if (context.Unit is not null)
                {
                    <span class="ds-table__secondary">@context.Unit</span>
                }
            </GridColumn>
            <GridColumn TItem="UserListItem" Title="@T("Статус")">
                <div class="ds-cluster">
                    @if (!context.IsActive)
                    {
                        <Badge Tone="Tone.Danger" Icon="ban">@T("Заблоковано")</Badge>
                    }
                    else if (context.IsLockedOut)
                    {
                        <Badge Tone="Tone.Outline" Icon="timer">@T("Тимчасово заблоковано")</Badge>
                    }
                    else
                    {
                        <Badge Tone="Tone.Inverse">@T("Активний")</Badge>
                    }
                    @if (!context.TwoFactorEnabled)
                    {
                        <Badge Tone="Tone.Dashed" Title="@T("Автентифікатор ще не прив'язано")">@T("Без 2FA")</Badge>
                    }
                </div>
            </GridColumn>
            <GridColumn TItem="UserListItem" Title="@T("Останній вхід")" SortKey="lastSignIn" Class="ds-nowrap">@Display.DateTime(context.LastSignInAt)</GridColumn>
            <GridColumn TItem="UserListItem" Title="@T("Дії")" Actions>
                <Button Href="@($"/admin/users/{context.Id}")" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" IconEnd="arrow-right">@T("Відкрити")</Button>
            </GridColumn>
        </Columns>
    </DataGrid>
}
else
{
    <GridSkeleton Columns="5" />
}
