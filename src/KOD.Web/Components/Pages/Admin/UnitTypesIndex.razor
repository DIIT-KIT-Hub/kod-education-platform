@page "/admin/unit-types"
@attribute [RequirePermission(Permissions.Structure.Manage)]
@attribute [StreamRendering]

<PageHeader Title="@T("Типи підрозділів")" Subtitle="@T("Назви рівнів структури у словнику вашої організації: департамент, управління, відділ, сектор, філія…")"
            Breadcrumbs="@([new(T("Адміністрування"), "/admin"), new(T("Структура"), "/admin/units"), new(T("Типи підрозділів"))])">
    <Actions>
        @if (CabinetWide)
        {
            <Button Href="/admin/unit-types/new" Icon="plus">@T("Новий тип")</Button>
        }
    </Actions>
</PageHeader>

@if (!CabinetWide)
{
    <Alert Tone="Tone.Outline" Icon="info">@T("Каталог типів спільний для всіх організацій кабінету, тому змінювати його може лише адміністратор усіх організацій. Ви можете використовувати ці типи для підрозділів своїх організацій.")</Alert>
}

@if (Items is not null)
{
    <DataGrid TItem="UnitTypeItem" Items="Items" Page="1" PageSize="@Math.Max(Items.Count, 1)" TotalCount="Items.Count" ShowPagination="false"
              Caption="@T("Типи підрозділів")" EmptyIcon="layers" EmptyTitle="@T("Типів ще немає")" EmptyText="@T("Створіть хоча б один тип, позначений як організація.")">
        <Columns>
            <GridColumn TItem="UnitTypeItem" Title="@T("Тип")" Primary>
                <a class="ds-table__primary ds-row" href="@($"/admin/unit-types/{context.Id}")"><Icon Name="@context.Icon" Size="IconSize.Small" /> @context.Name</a>
                <span class="ds-table__secondary">@context.Description</span>
            </GridColumn>
            <GridColumn TItem="UnitTypeItem" Title="@T("Код")"><span class="ds-mono">@context.Code</span></GridColumn>
            <GridColumn TItem="UnitTypeItem" Title="@T("Рівень")">
                @if (context.IsOrganization)
                {
                    <Badge Tone="Tone.Inverse">@T("Організація")</Badge>
                }
                else
                {
                    <Badge Tone="Tone.Outline">@T("Підрозділ")</Badge>
                }
            </GridColumn>
            <GridColumn TItem="UnitTypeItem" Title="@T("Підрозділів")">@context.UnitCount</GridColumn>
            <GridColumn TItem="UnitTypeItem" Title="@T("Дії")" Actions>
                <Button Href="@($"/admin/unit-types/{context.Id}")" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Icon="@(CabinetWide ? "pencil" : "eye")">@(CabinetWide ? T("Редагувати") : T("Переглянути"))</Button>
            </GridColumn>
        </Columns>
    </DataGrid>
}
else
{
    <GridSkeleton Columns="5" />
}
