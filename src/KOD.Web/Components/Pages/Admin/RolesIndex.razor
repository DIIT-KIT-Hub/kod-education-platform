@page "/admin/roles"
@attribute [RequirePermission(Permissions.Roles.Manage)]
@attribute [StreamRendering]

<PageHeader Title="@T("Ролі та дозволи")" Subtitle="@T("Роль — набір дозволів для посади. Користувач отримує дозволи всіх своїх посад.")"
            Breadcrumbs="@([new(T("Адміністрування"), "/admin"), new(T("Ролі"))])">
    <Actions>
        <Button Href="/admin/roles/new" Icon="plus">@T("Нова роль")</Button>
    </Actions>
</PageHeader>

<GridToolbar Search="@Search" Placeholder="@T("Назва або код ролі")" />

@if (Result is not null)
{
    <DataGrid TItem="RoleListItem" Items="Result.Items" Page="Result.Page" PageSize="Result.PageSize" TotalCount="Result.TotalCount"
              SortBy="@SortBy" Descending="Descending" Caption="@T("Ролі")" EmptyIcon="shield">
        <Columns>
            <GridColumn TItem="RoleListItem" Title="@T("Роль")" SortKey="name" Primary>
                <a class="ds-table__primary" href="@($"/admin/roles/{context.Id}")">@context.Name</a>
                <span class="ds-table__secondary">@context.Description</span>
            </GridColumn>
            <GridColumn TItem="RoleListItem" Title="@T("Код")" SortKey="code"><span class="ds-mono">@context.Code</span></GridColumn>
            <GridColumn TItem="RoleListItem" Title="@T("Тип")">
                @if (context.IsSystem)
                {
                    <Badge Tone="Tone.Outline">@T("Системна")</Badge>
                }
                else
                {
                    <Badge Tone="Tone.Dashed">@T("Власна")</Badge>
                }
                @if (context.IsLeadership)
                {
                    <Badge>@T("Керівна")</Badge>
                }
            </GridColumn>
            <GridColumn TItem="RoleListItem" Title="@T("Дозволи")">@context.PermissionCount</GridColumn>
            <GridColumn TItem="RoleListItem" Title="@T("Користувачі")">@context.UserCount</GridColumn>
            <GridColumn TItem="RoleListItem" Title="@T("Дії")" Actions>
                <Button Href="@($"/admin/roles/{context.Id}")" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Icon="pencil">@T("Налаштувати")</Button>
            </GridColumn>
        </Columns>
    </DataGrid>
}
else
{
    <GridSkeleton Columns="6" />
}
