@page "/documents"
@attribute [RequirePermission(Permissions.Documents.View)]
@attribute [StreamRendering]

<PageHeader Title="Документи" Subtitle="Реєстр документів, маршрути погодження та підписання.">
    <Actions>
        @if (CanCreate)
        {
            <Button Href="/documents/new" Icon="file-plus">Новий документ</Button>
        }
    </Actions>
</PageHeader>

<Tabs Label="Розділи документів">
    <TabLink Href="@ScopeHref(DocumentScope.AwaitingMe)" Active="@(CurrentScope == DocumentScope.AwaitingMe)" Icon="signature">Очікують мого підпису</TabLink>
    <TabLink Href="@ScopeHref(DocumentScope.Authored)" Active="@(CurrentScope == DocumentScope.Authored)" Icon="pen-line">Створені мною</TabLink>
    <TabLink Href="@ScopeHref(DocumentScope.Involved)" Active="@(CurrentScope == DocumentScope.Involved)" Icon="users">Я в маршруті</TabLink>
    <TabLink Href="@ScopeHref(DocumentScope.Accessible)" Active="@(CurrentScope == DocumentScope.Accessible)" Icon="layers">Усі доступні</TabLink>
</Tabs>

<GridToolbar Search="@Search" Placeholder="Назва або реєстраційний номер" Preserve="@(new Dictionary<string, string?> { ["scope"] = Scope })">
    <select name="status" class="ds-select" aria-label="Статус" data-autosubmit>
        <option value="">Усі статуси</option>
        @foreach (var status in Enum.GetValues<DocumentStatus>())
        {
            <option value="@status" selected="@(status.ToString() == Status)">@Display.Text(status)</option>
        }
    </select>
    <select name="kind" class="ds-select" aria-label="Вид документа" data-autosubmit>
        <option value="">Усі види</option>
        @foreach (var kind in Enum.GetValues<DocumentKind>())
        {
            <option value="@kind" selected="@(kind.ToString() == Kind)">@Display.Text(kind)</option>
        }
    </select>
</GridToolbar>

@if (Result is null)
{
    <div class="ds-stack">
        @for (var i = 0; i < 5; i++)
        {
            <div class="ds-skeleton" style="height:3.5rem"></div>
        }
    </div>
}
else
{
    <DataGrid TItem="DocumentListItem" Items="Result.Items" Page="Result.Page" PageSize="Result.PageSize" TotalCount="Result.TotalCount"
              SortBy="@SortBy" Descending="Descending" Caption="Документи"
              EmptyIcon="file-text" EmptyTitle="Документів не знайдено" EmptyText="@EmptyText">
        <Columns>
            <GridColumn TItem="DocumentListItem" Title="Документ" SortKey="title" Primary>
                <a class="ds-table__primary" href="@($"/documents/{context.Id}")">@context.Title</a>
                <span class="ds-table__secondary">@Display.Text(context.Kind) · @context.UnitName</span>
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="Номер" SortKey="number" Class="ds-col-number">
                @context.RegistrationNumber
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="Статус" SortKey="status">
                <div class="ds-cluster">
                    <DocumentStatusBadge Status="context.Status" />
                    @if (context.AwaitingMe)
                    {
                        <Badge Tone="Tone.Inverse" Icon="signature">Ваш підпис</Badge>
                    }
                </div>
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="Підписи">
                <span class="ds-nowrap">@context.SignedCount / @context.SignersCount</span>
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="Автор">
                @context.AuthorName
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="Створено" SortKey="created" Class="ds-nowrap">
                @Display.DateTime(context.CreatedAt)
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="Дії" Actions>
                <Button Href="@($"/documents/{context.Id}")" Variant="@(context.AwaitingMe ? ButtonVariant.Primary : ButtonVariant.Ghost)" Size="ControlSize.Small" IconEnd="arrow-right">
                    @(context.AwaitingMe ? "Підписати" : "Відкрити")
                </Button>
            </GridColumn>
        </Columns>
    </DataGrid>
}

@if (ErrorMessage is not null)
{
    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
}
