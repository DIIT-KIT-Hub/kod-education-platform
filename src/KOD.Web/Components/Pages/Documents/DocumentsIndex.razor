@page "/documents"
@attribute [RequirePermission(Permissions.Documents.View)]
@attribute [StreamRendering]

<PageHeader Title="@T("Документи")" Subtitle="@T("Реєстр документів, маршрути погодження та підписання.")">
    <Actions>
        @if (CanCreate)
        {
            <Button Href="/documents/new" Icon="file-plus">@T("Новий документ")</Button>
        }
    </Actions>
</PageHeader>

<Tabs Label="@T("Розділи документів")">
    <TabLink Href="@ScopeHref(DocumentScope.AwaitingMe)" Active="@(CurrentScope == DocumentScope.AwaitingMe)" Icon="signature">@T("Очікують мого підпису")</TabLink>
    <TabLink Href="@ScopeHref(DocumentScope.Authored)" Active="@(CurrentScope == DocumentScope.Authored)" Icon="pen-line">@T("Створені мною")</TabLink>
    <TabLink Href="@ScopeHref(DocumentScope.Involved)" Active="@(CurrentScope == DocumentScope.Involved)" Icon="users">@T("Я в маршруті")</TabLink>
    <TabLink Href="@ScopeHref(DocumentScope.SignedByMe)" Active="@(CurrentScope == DocumentScope.SignedByMe)" Icon="badge-check">@T("Підписані мною")</TabLink>
    <TabLink Href="@ScopeHref(DocumentScope.Accessible)" Active="@(CurrentScope == DocumentScope.Accessible)" Icon="layers">@T("Усі доступні")</TabLink>
</Tabs>

<GridToolbar Search="@Search" Placeholder="@T("Назва або реєстраційний номер")" Preserve="@(new Dictionary<string, string?> { ["scope"] = Scope })">
    <select name="status" class="ds-select" aria-label="@T("Статус")" data-autosubmit>
        <option value="">@T("Усі статуси")</option>
        @foreach (var status in Enum.GetValues<DocumentStatus>())
        {
            <option value="@status" selected="@(status.ToString() == Status)">@Display.Text(status)</option>
        }
    </select>
    <select name="kind" class="ds-select" aria-label="@T("Вид документа")" data-autosubmit>
        <option value="">@T("Усі види")</option>
        @foreach (var kind in Enum.GetValues<DocumentKind>())
        {
            <option value="@kind" selected="@(kind.ToString() == Kind)">@Display.Text(kind)</option>
        }
    </select>
</GridToolbar>

@if (Result is null)
{
    <GridSkeleton Columns="7" />
}
else
{
    <DataGrid TItem="DocumentListItem" Items="Result.Items" Page="Result.Page" PageSize="Result.PageSize" TotalCount="Result.TotalCount"
              SortBy="@SortBy" Descending="Descending" Caption="@T("Документи")"
              EmptyIcon="file-text" EmptyTitle="@T("Документів не знайдено")" EmptyText="@EmptyText">
        <Columns>
            <GridColumn TItem="DocumentListItem" Title="@T("Документ")" SortKey="title" Primary>
                <a class="ds-table__primary" href="@($"/documents/{context.Id}")">@context.Title</a>
                <span class="ds-table__secondary">@Display.Text(context.Kind) · @context.UnitName</span>
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="@T("Номер")" SortKey="number" Class="ds-col-number">
                @context.RegistrationNumber
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="@T("Статус")" SortKey="status">
                <div class="ds-cluster">
                    <DocumentStatusBadge Status="context.Status" />
                    @if (context.AwaitingMe)
                    {
                        <Badge Tone="Tone.Inverse" Icon="signature">@T("Ваш підпис")</Badge>
                    }
                </div>
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="@T("Підписи")">
                <span class="ds-nowrap">@context.SignedCount / @context.SignersCount</span>
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="@T("Автор")">
                <PersonName Name="@context.AuthorName" PhotoId="@context.AuthorPhotoId" />
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="@T("Створено")" SortKey="created" Class="ds-nowrap">
                @Display.DateTime(context.CreatedAt)
            </GridColumn>
            <GridColumn TItem="DocumentListItem" Title="@T("Дії")" Actions>
                <Button Href="@($"/documents/{context.Id}")" Variant="@(context.AwaitingMe ? ButtonVariant.Primary : ButtonVariant.Ghost)" Size="ControlSize.Small" IconEnd="arrow-right">
                    @(context.AwaitingMe ? T("Підписати") : T("Відкрити"))
                </Button>
            </GridColumn>
        </Columns>
    </DataGrid>
}

@if (ErrorMessage is not null)
{
    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
}
