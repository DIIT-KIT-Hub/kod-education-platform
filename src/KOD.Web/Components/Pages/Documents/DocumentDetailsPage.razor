@page "/documents/{Id:guid}"
@attribute [RequirePermission(Permissions.Documents.View)]

@if (Document is null)
{
    <PageHeader Title="@T("Документ")" Breadcrumbs="@([new(T("Документи"), "/documents"), new(T("Документ"))])" />
    <Card>
        <EmptyState Icon="file-x" Title="@T("Документ не знайдено")" Text="@(ErrorMessage ?? T("Документ не існує або у вас немає до нього доступу."))">
            <Button Href="/documents" Icon="arrow-left">@T("До реєстру")</Button>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@Document.Title" Breadcrumbs="@([new(T("Документи"), "/documents"), new(T("№ {0}", Document.RegistrationNumber))])">
        <ChildContent>
            <div class="ds-cluster">
                <DocumentStatusBadge Status="Document.Status" />
                <Badge>@Display.Text(Document.Kind)</Badge>
                <Badge Tone="Tone.Dashed">@T("№ {0}", Document.RegistrationNumber)</Badge>
            </div>
        </ChildContent>
        <Actions>
            @if (Document.Actions.CanSign)
            {
                <button type="button" class="ds-btn" data-dialog-open="sign-dialog"><Icon Name="signature" /> <span>@T("Підписати")</span></button>
            }
            @if (Document.Actions.CanReject)
            {
                <button type="button" class="ds-btn ds-btn--secondary" data-dialog-open="reject-dialog"><Icon Name="ban" /> <span>@T("Відмовити")</span></button>
            }
            @if (Document.Actions.CanEdit)
            {
                <Button Href="@($"/documents/{Document.Id}/edit")" Variant="ButtonVariant.Secondary" Icon="pencil">@T("Редагувати")</Button>
            }
            @if (Document.Actions.CanSubmit)
            {
                <form method="post" @formname="document-submit" @onsubmit="SubmitAsync" data-confirm="@T("Надіслати документ на підписання?")">
                    <AntiforgeryToken />
                    <Button Type="submit" Icon="send">@T("На підписання")</Button>
                </form>
            }
            @if (Document.Actions.CanWithdraw)
            {
                <form method="post" @formname="document-withdraw" @onsubmit="WithdrawAsync" data-confirm="@T("Відкликати документ у чернетки?")">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="undo-2">@T("Відкликати")</Button>
                </form>
            }
            @if (Document.Actions.CanArchive)
            {
                <form method="post" @formname="document-archive" @onsubmit="ArchiveAsync" data-confirm="@T("Перемістити документ в архів?")">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="archive">@T("В архів")</Button>
                </form>
            }
            @if (Document.Actions.CanDelete)
            {
                <form method="post" @formname="document-delete" @onsubmit="DeleteAsync" data-confirm="@T("Видалити документ остаточно?")">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Ghost" Icon="trash-2" IconOnly aria-label="@T("Видалити")" title="@T("Видалити")" />
                </form>
            }
        </Actions>
    </PageHeader>

    @if (ErrorMessage is not null)
    {
        <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
    }

    <div class="ds-split ds-split--wide-aside">
        <div class="ds-stack ds-stack--lg ds-stagger">
            @if (Document.Actions.CanSign)
            {
                <Alert Tone="Tone.Inverse" Icon="signature" Title="@T("Документ очікує вашого підпису")">
                    @T("Перевірте файл і натисніть «Підписати». Ключ і пароль використовуються лише у вашому браузері.")
                </Alert>
            }

            @if (Document.Status == DocumentStatus.Rejected && Document.Actions.CanEdit)
            {
                <Alert Tone="Tone.Outline" Icon="ban" Title="@T("Документ відхилено")">
                    @T("Причину вказано в маршруті підписання. Натисніть «Редагувати», щоб виправити файл, реквізити чи маршрут, або «На підписання», щоб надіслати документ повторно без змін. Ті, хто вже підписав поточний файл, не підписуватимуть його знову.")
                </Alert>
            }

            <Card Title="@T("Файл документа")">
                <div class="doc-file">
                    <span class="doc-file__icon"><Icon Name="file-text" /></span>
                    <div class="ds-stack ds-stack--sm" style="flex:1;min-width:0">
                        <span class="doc-file__name">@Document.File.FileName</span>
                        <span class="ds-text-sm ds-muted">@Display.FileSize(Document.File.Size) · @Document.File.ContentType</span>
                    </div>
                    <Button Href="@($"/api/v1/documents/{Document.Id}/file")" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Icon="download" download>@T("Завантажити")</Button>
                </div>
                <p class="ds-text-xs ds-muted">SHA-256: <span class="ds-mono">@Document.File.Sha256</span></p>
                @if (Document.CombinedSignatureId is { } combined)
                {
                    <div class="doc-file doc-file--signed">
                        <span class="doc-file__icon"><Icon Name="badge-check" /></span>
                        <div class="ds-stack ds-stack--sm" style="flex:1;min-width:0">
                            <span class="doc-file__name">@T("Документ з усіма підписами")</span>
                            <span class="ds-text-sm ds-muted">@T("Один файл, що містить документ і всі накладені підписи.")</span>
                        </div>
                        <Button Href="@($"/api/v1/documents/{Document.Id}/signatures/{combined}/file")" Size="ControlSize.Small" Icon="download" download>@T("Завантажити")</Button>
                    </div>
                }
                else if (Document.Signatures.Count > 0)
                {
                    <p class="ds-text-sm ds-muted">@T("Це оригінал без підписів. Підписані файли завантажуйте в розділі «Підписи».")</p>
                }
            </Card>

            <Card Title="@T("Відомості")">
                <dl class="ds-dl">
                    <dt>@T("Реєстраційний номер")</dt>
                    <dd>@Document.RegistrationNumber</dd>
                    <dt>@T("Вид")</dt>
                    <dd>@Display.Text(Document.Kind)</dd>
                    <dt>@T("Підрозділ")</dt>
                    <dd><a class="ds-link" href="@($"/structure/{Document.Unit.Id}")">@Document.Unit.Name</a></dd>
                    <dt>@T("Автор")</dt>
                    <dd>@Document.Author.FullName</dd>
                    <dt>@T("Порядок підписання")</dt>
                    <dd>@Display.Text(Document.SigningMode)</dd>
                    <dt>@T("Створено")</dt>
                    <dd>@Display.DateTime(Document.CreatedAt)</dd>
                    <dt>@T("Надіслано на підпис")</dt>
                    <dd>@Display.DateTime(Document.SubmittedAt)</dd>
                    <dt>@T("Завершено")</dt>
                    <dd>@Display.DateTime(Document.CompletedAt)</dd>
                </dl>
                @if (Document.Description is not null)
                {
                    <hr />
                    <p class="ds-muted" style="white-space:pre-line">@Document.Description</p>
                }
            </Card>

            <Card Title="@T("Підписи")" Subtitle="@T("Кваліфіковані електронні підписи, накладені на документ")">
                @if (Document.Signatures.Count == 0)
                {
                    <EmptyState Icon="signature" Title="@T("Підписів ще немає")" />
                }
                else
                {
                    <ul class="ds-list">
                        @foreach (var signature in Document.Signatures)
                        {
                            <li class="ds-list__item">
                                <span class="ds-stat__icon"><Icon Name="badge-check" /></span>
                                <div class="ds-list__body">
                                    <span class="ds-list__title">@signature.Certificate.SubjectFullName</span>
                                    <span class="ds-list__meta">
                                        @Display.Text(signature.Format)@(signature.Level is null ? null : $" {signature.Level}") · @Display.Text(signature.Packaging) · @Display.DateTime(signature.SignedAt)
                                    </span>
                                    <span class="ds-list__meta">
                                        @signature.Certificate.IssuerName · @T("сертифікат №") <span class="ds-mono">@signature.Certificate.SerialNumber</span>
                                        @if (signature.Certificate.SubjectTaxId is not null)
                                        {
                                            <span> · @signature.Certificate.SubjectTaxId</span>
                                        }
                                    </span>
                                </div>
                                <Button Href="@($"/api/v1/documents/{Document.Id}/signatures/{signature.Id}/file")" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Icon="download" title="@signature.FileName" download>
                                    @(Document.CombinedSignatureId is not null ? T("Версія після цього підпису") : signature.Format == SignatureFormat.PAdES ? T("Підписаний PDF") : T("Файл підпису"))
                                </Button>
                            </li>
                        }
                    </ul>
                    @if (Languages.Current == Languages.English)
                    {
                        <p class="ds-text-xs ds-muted">You can verify any signature on the <a class="ds-link" href="/signing/verify">Signature verification</a> page.</p>
                    }
                    else
                    {
                        <p class="ds-text-xs ds-muted">Перевірити будь-який підпис можна на сторінці <a class="ds-link" href="/signing/verify">«Перевірка підпису»</a>.</p>
                    }
                }
            </Card>
        </div>

        <Card Title="@T("Маршрут підписання")" Subtitle="@Display.Text(Document.SigningMode)">
            @if (Document.Signers.Count == 0)
            {
                <EmptyState Icon="users" Title="@T("Підписантів не додано")" />
            }
            else
            {
                <Timeline>
                    @foreach (var signer in Document.Signers)
                    {
                        <TimelineItem State="@StateOf(signer)" Marker="@signer.Order.ToString(Display.Culture)" Title="@signer.FullName"
                                      Meta="@(signer.Position ?? Display.Text(signer.Status))">
                            <span class="ds-text-sm ds-muted">
                                @Display.Text(signer.Status)@(signer.DecidedAt is null ? null : $" · {Display.DateTime(signer.DecidedAt)}")
                            </span>
                            @if (signer.Comment is not null)
                            {
                                <Alert Tone="Tone.Danger" Icon="ban">@signer.Comment</Alert>
                            }
                        </TimelineItem>
                    }
                </Timeline>
            }
        </Card>
    </div>

    @if (Document.Actions.CanSign)
    {
        <Dialog Id="sign-dialog" Title="@T("Підписання документа")" Description="@($"{T("№ {0}", Document.RegistrationNumber)} · {Document.File.FileName}")" Wide>
            <SigningHost Mode="document" DocumentId="Document.Id" DocumentTitle="@Document.Title" FileName="@Document.File.FileName"
                         FileSha256="@Document.File.Sha256" IsPdf="Document.File.IsPdf" />
        </Dialog>
    }

    @if (Document.Actions.CanReject)
    {
        <Dialog Id="reject-dialog" Title="@T("Відмова в підписанні")" Description="@T("Автор побачить причину й зможе виправити документ.")">
            <EditForm Model="Reject" FormName="document-reject" OnValidSubmit="RejectAsync" class="ds-form" Enhance>
                <DataAnnotationsValidator />
                <Field Label="@T("Причина")" For="reject-reason" Required>
                    <InputTextArea id="reject-reason" @bind-Value="Reject.Reason" class="ds-textarea" maxlength="1000" />
                    <ValidationError For="() => Reject.Reason" />
                </Field>
                <div class="ds-dialog__actions">
                    <button type="button" class="ds-btn ds-btn--secondary" data-dialog-close>@T("Скасувати")</button>
                    <Button Type="submit" Variant="ButtonVariant.Danger" Icon="ban">@T("Відмовити")</Button>
                </div>
            </EditForm>
        </Dialog>
    }
}
