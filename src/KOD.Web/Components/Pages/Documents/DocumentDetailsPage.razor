@page "/documents/{Id:guid}"
@attribute [RequirePermission(Permissions.Documents.View)]

@if (Document is null)
{
    <PageHeader Title="Документ" Breadcrumbs="@([new("Документи", "/documents"), new("Документ")])" />
    <Card>
        <EmptyState Icon="file-x" Title="Документ не знайдено" Text="@(ErrorMessage ?? "Документ не існує або у вас немає до нього доступу.")">
            <Button Href="/documents" Icon="arrow-left">До реєстру</Button>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@Document.Title" Breadcrumbs="@([new("Документи", "/documents"), new($"№ {Document.RegistrationNumber}")])">
        <ChildContent>
            <div class="ds-cluster">
                <DocumentStatusBadge Status="Document.Status" />
                <Badge>@Display.Text(Document.Kind)</Badge>
                <Badge Tone="Tone.Dashed">№ @Document.RegistrationNumber</Badge>
            </div>
        </ChildContent>
        <Actions>
            @if (Document.Actions.CanSign)
            {
                <button type="button" class="ds-btn" data-dialog-open="sign-dialog"><Icon Name="signature" /> <span>Підписати</span></button>
            }
            @if (Document.Actions.CanReject)
            {
                <button type="button" class="ds-btn ds-btn--secondary" data-dialog-open="reject-dialog"><Icon Name="ban" /> <span>Відмовити</span></button>
            }
            @if (Document.Actions.CanSubmit)
            {
                <form method="post" @formname="document-submit" @onsubmit="SubmitAsync" data-confirm="Надіслати документ на підписання?">
                    <AntiforgeryToken />
                    <Button Type="submit" Icon="send">На підписання</Button>
                </form>
            }
            @if (Document.Actions.CanWithdraw)
            {
                <form method="post" @formname="document-withdraw" @onsubmit="WithdrawAsync" data-confirm="Відкликати документ у чернетки?">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="undo-2">Відкликати</Button>
                </form>
            }
            @if (Document.Actions.CanArchive)
            {
                <form method="post" @formname="document-archive" @onsubmit="ArchiveAsync" data-confirm="Перемістити документ в архів?">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="archive">В архів</Button>
                </form>
            }
            @if (Document.Actions.CanDelete)
            {
                <form method="post" @formname="document-delete" @onsubmit="DeleteAsync" data-confirm="Видалити документ остаточно?">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Ghost" Icon="trash-2" IconOnly aria-label="Видалити" title="Видалити" />
                </form>
            }
        </Actions>
    </PageHeader>

    @if (ErrorMessage is not null)
    {
        <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
    }

    <div class="ds-split ds-split--wide-aside">
        <div class="ds-stack ds-stack--lg ds-stagger">
            @if (Document.Actions.CanSign)
            {
                <Alert Tone="Tone.Inverse" Icon="signature" Title="Документ очікує вашого підпису">
                    Перевірте файл і натисніть «Підписати». Ключ і пароль використовуються лише у вашому браузері.
                </Alert>
            }

            <Card Title="Файл документа">
                <div class="doc-file">
                    <span class="doc-file__icon"><Icon Name="file-text" /></span>
                    <div class="ds-stack ds-stack--sm" style="flex:1;min-width:0">
                        <span class="doc-file__name">@Document.File.FileName</span>
                        <span class="ds-text-sm ds-muted">@Display.FileSize(Document.File.Size) · @Document.File.ContentType</span>
                    </div>
                    <Button Href="@($"/api/v1/documents/{Document.Id}/file")" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Icon="download" download>Завантажити</Button>
                </div>
                <p class="ds-text-xs ds-muted">SHA-256: <span class="ds-mono">@Document.File.Sha256</span></p>
            </Card>

            <Card Title="Відомості">
                <dl class="ds-dl">
                    <dt>Реєстраційний номер</dt>
                    <dd>@Document.RegistrationNumber</dd>
                    <dt>Вид</dt>
                    <dd>@Display.Text(Document.Kind)</dd>
                    <dt>Підрозділ</dt>
                    <dd><a class="ds-link" href="@($"/structure/{Document.Unit.Id}")">@Document.Unit.Name</a></dd>
                    <dt>Автор</dt>
                    <dd>@Document.Author.FullName</dd>
                    <dt>Порядок підписання</dt>
                    <dd>@Display.Text(Document.SigningMode)</dd>
                    <dt>Створено</dt>
                    <dd>@Display.DateTime(Document.CreatedAt)</dd>
                    <dt>Надіслано на підпис</dt>
                    <dd>@Display.DateTime(Document.SubmittedAt)</dd>
                    <dt>Завершено</dt>
                    <dd>@Display.DateTime(Document.CompletedAt)</dd>
                </dl>
                @if (Document.Description is not null)
                {
                    <hr />
                    <p class="ds-muted" style="white-space:pre-line">@Document.Description</p>
                }
            </Card>

            <Card Title="Підписи" Subtitle="Кваліфіковані електронні підписи, накладені на документ">
                @if (Document.Signatures.Count == 0)
                {
                    <EmptyState Icon="signature" Title="Підписів ще немає" />
                }
                else
                {
                    <ul class="ds-list">
                        @foreach (var signature in Document.Signatures)
                        {
                            <li class="ds-list__item">
                                <span class="ds-stat__icon"><Icon Name="badge-check" /></span>
                                <div class="ds-list__body">
                                    <span class="ds-list__title">@signature.Certificate.SubjectFullName</span>
                                    <span class="ds-list__meta">
                                        @Display.Text(signature.Format)@(signature.Level is null ? null : $" {signature.Level}") · @Display.Text(signature.Packaging) · @Display.DateTime(signature.SignedAt)
                                    </span>
                                    <span class="ds-list__meta">
                                        @signature.Certificate.IssuerName · сертифікат № <span class="ds-mono">@signature.Certificate.SerialNumber</span>
                                        @if (signature.Certificate.SubjectTaxId is not null)
                                        {
                                            <span> · @signature.Certificate.SubjectTaxId</span>
                                        }
                                    </span>
                                </div>
                                <Button Href="@($"/api/v1/documents/{Document.Id}/signatures/{signature.Id}/file")" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Icon="download" IconOnly aria-label="Завантажити підпис" title="@signature.FileName" download />
                            </li>
                        }
                    </ul>
                    <p class="ds-text-xs ds-muted">Перевірити будь-який підпис можна на сторінці <a class="ds-link" href="/signing/verify">«Перевірка підпису»</a>.</p>
                }
            </Card>
        </div>

        <Card Title="Маршрут підписання" Subtitle="@Display.Text(Document.SigningMode)">
            @if (Document.Signers.Count == 0)
            {
                <EmptyState Icon="users" Title="Підписантів не додано" />
            }
            else
            {
                <Timeline>
                    @foreach (var signer in Document.Signers)
                    {
                        <TimelineItem State="@StateOf(signer)" Marker="@signer.Order.ToString(Display.Culture)" Title="@signer.FullName"
                                      Meta="@(signer.Position ?? Display.Text(signer.Status))">
                            <span class="ds-text-sm ds-muted">
                                @Display.Text(signer.Status)@(signer.DecidedAt is null ? null : $" · {Display.DateTime(signer.DecidedAt)}")
                            </span>
                            @if (signer.Comment is not null)
                            {
                                <Alert Tone="Tone.Danger" Icon="ban">@signer.Comment</Alert>
                            }
                        </TimelineItem>
                    }
                </Timeline>
            }
        </Card>
    </div>

    @if (Document.Actions.CanSign)
    {
        <Dialog Id="sign-dialog" Title="Підписання документа" Description="@($"№ {Document.RegistrationNumber} · {Document.File.FileName}")" Wide>
            <SigningHost Mode="document" DocumentId="Document.Id" DocumentTitle="@Document.Title" FileName="@Document.File.FileName"
                         FileSha256="@Document.File.Sha256" IsPdf="Document.File.IsPdf" />
        </Dialog>
    }

    @if (Document.Actions.CanReject)
    {
        <Dialog Id="reject-dialog" Title="Відмова в підписанні" Description="Автор побачить причину й зможе виправити документ.">
            <EditForm Model="Reject" FormName="document-reject" OnValidSubmit="RejectAsync" class="ds-form" Enhance>
                <DataAnnotationsValidator />
                <Field Label="Причина" For="reject-reason" Required>
                    <InputTextArea id="reject-reason" @bind-Value="Reject.Reason" class="ds-textarea" maxlength="1000" />
                    <ValidationMessage For="() => Reject.Reason" />
                </Field>
                <div class="ds-dialog__actions">
                    <button type="button" class="ds-btn ds-btn--secondary" data-dialog-close>Скасувати</button>
                    <Button Type="submit" Variant="ButtonVariant.Danger" Icon="ban">Відмовити</Button>
                </div>
            </EditForm>
        </Dialog>
    }
}
