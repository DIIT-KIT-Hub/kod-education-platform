@page "/signing/verify"
@attribute [RequirePermission(Permissions.Signing.Use)]

<PageHeader Title="Перевірка підпису" Subtitle="Перевірте підписаний файл: хто підписав, ким виданий сертифікат, час підпису та цілісність даних." />

<Tabs Label="Інструменти підпису">
    <TabLink Href="/signing" Icon="signature">Підписати</TabLink>
    <TabLink Href="/signing/verify" Active Icon="badge-check">Перевірити</TabLink>
</Tabs>

<div class="ds-split ds-split--wide-aside">
    <Card>
        <SigningHost Mode="verify" />
    </Card>
    <SigningInfo />
</div>
