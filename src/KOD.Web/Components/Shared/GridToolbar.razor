<form method="get" class="ds-toolbar" data-enhance role="search">
    @foreach (var (name, value) in Preserve)
    {
        @if (value is not null)
        {
            <input type="hidden" name="@name" value="@value" />
        }
    }
    <div class="ds-toolbar__search">
        <Icon Name="search" />
        <input type="search" name="search" value="@Search" class="ds-input" placeholder="@Placeholder" aria-label="@Placeholder" maxlength="200" />
    </div>
    @ChildContent
    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="filter">Знайти</Button>
</form>
