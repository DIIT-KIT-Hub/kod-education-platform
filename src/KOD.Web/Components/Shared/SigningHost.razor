@* The signing UI is rendered by wwwroot/js/signing/signing-ui.js inside this element. Key files and passwords are handled
   exclusively in the browser (Web Worker) and never reach Blazor or the server. *@
<div class="sign-panel"
     data-signing
     data-mode="@Mode"
     data-worker="@Assets["js/signing/eusign.worker.js"]"
     data-lib-types="@Assets["lib/eusign/euscpt.js"]"
     data-lib-module="@Assets["lib/eusign/euscpm.js"]"
     data-lib-core="@Assets["lib/eusign/euscp.ex.js"]"
     data-proxy="@ProxyUrl"
     data-cas="@ProvidersUrl"
     data-certificates="@CertificatesUrl"
     data-document-id="@DocumentId"
     data-document-title="@DocumentTitle"
     data-file-url="@FileUrl"
     data-file-name="@FileName"
     data-file-sha256="@FileSha256"
     data-file-pdf="@(IsPdf ? "true" : "false")"
     data-upload-url="@UploadUrl">
    <div class="app-loading"><span class="ds-spinner"></span></div>
    <noscript><Alert Tone="Tone.Danger">Для підписання потрібен увімкнений JavaScript.</Alert></noscript>
</div>
