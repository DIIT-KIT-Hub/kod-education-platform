<li>
    @if (Node.Children.Count > 0)
    {
        <details open="@Expanded">
            <summary>
                <span class="ds-tree__row">
                    <Icon Name="chevron-right" Class="ds-tree__chevron" Size="IconSize.Small" />
                    <Icon Name="@Display.IconOf(Node.Type)" />
                    <a class="ds-tree__name" href="@($"/structure/{Node.Id}")">@Node.Name</a>
                    <span class="ds-text-xs ds-muted ds-hide-mobile">@Display.Text(Node.Type)</span>
                    @if (Node.StaffCount > 0)
                    {
                        <Badge Title="Працівників">@Node.StaffCount</Badge>
                    }
                </span>
            </summary>
            <ul>
                @foreach (var child in Node.Children)
                {
                    <UnitTreeBranch Node="child" />
                }
            </ul>
        </details>
    }
    else
    {
        <span class="ds-tree__row">
            <span class="ds-tree__spacer"></span>
            <Icon Name="@Display.IconOf(Node.Type)" />
            <a class="ds-tree__name" href="@($"/structure/{Node.Id}")">@Node.Name</a>
            <span class="ds-text-xs ds-muted ds-hide-mobile">@Display.Text(Node.Type)</span>
            @if (Node.StaffCount > 0)
            {
                <Badge Title="Працівників">@Node.StaffCount</Badge>
            }
        </span>
    }
</li>
