@page "/account/login-recovery"
@attribute [AllowAnonymous]

<PageTitle>@T("Резервний код · КОД")</PageTitle>

<header class="auth-card__header">
    <span class="ds-stat__icon ds-animate-pop"><Icon Name="key-round" /></span>
    <h1>@T("Вхід за резервним кодом")</h1>
    <p>@T("Використайте один із резервних кодів, отриманих під час підключення автентифікатора. Кожен код діє лише один раз.")</p>
</header>

@if (ErrorMessage is not null)
{
    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
}

<EditForm Model="Input" method="post" OnValidSubmit="VerifyAsync" FormName="login-recovery" class="ds-form" Enhance data-busy-on-submit>
    <DataAnnotationsValidator />
    <Field Label="@T("Резервний код")" For="recovery-code">
        <InputText id="recovery-code" @bind-Value="Input.Code" class="ds-input ds-mono" autocomplete="off" autofocus />
        <ValidationError For="() => Input.Code" />
    </Field>
    <Button Type="submit" Size="ControlSize.Large" Block>@T("Увійти")</Button>
</EditForm>

<p class="ds-text-sm ds-muted">@T("Після входу згенеруйте нові резервні коди у профілі.")</p>
