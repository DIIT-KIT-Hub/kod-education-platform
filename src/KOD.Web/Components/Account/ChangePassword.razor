@page "/account/change-password"
@attribute [Authorize]

<PageTitle>Зміна пароля · КОД</PageTitle>

<header class="auth-card__header">
    <span class="ds-stat__icon ds-animate-pop"><Icon Name="key-round" /></span>
    <h1>@(IsForced ? "Встановіть власний пароль" : "Зміна пароля")</h1>
    <p>
        @if (IsForced)
        {
            <span>Ви увійшли з тимчасовим паролем. Задайте власний пароль, щоб продовжити роботу.</span>
        }
        else
        {
            <span>Після зміни пароля всі інші сесії буде завершено.</span>
        }
    </p>
</header>

@if (ErrorMessage is not null)
{
    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
}

<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password" class="ds-form" Enhance data-busy-on-submit>
    <DataAnnotationsValidator />
    <Field Label="Поточний пароль" For="current-password">
        <InputText id="current-password" type="password" @bind-Value="Input.CurrentPassword" class="ds-input" autocomplete="current-password" />
        <ValidationMessage For="() => Input.CurrentPassword" />
    </Field>
    <Field Label="Новий пароль" For="new-password" Hint="Щонайменше 12 символів: великі й малі латинські літери та цифри.">
        <InputText id="new-password" type="password" @bind-Value="Input.NewPassword" class="ds-input" autocomplete="new-password" />
        <ValidationMessage For="() => Input.NewPassword" />
    </Field>
    <Field Label="Повторіть новий пароль" For="confirm-password">
        <InputText id="confirm-password" type="password" @bind-Value="Input.ConfirmPassword" class="ds-input" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </Field>
    <Button Type="submit" Size="ControlSize.Large" Block>Зберегти пароль</Button>
</EditForm>

@if (!IsForced)
{
    <Button Href="/profile/security" Variant="ButtonVariant.Ghost" Icon="arrow-left">Повернутися</Button>
}
