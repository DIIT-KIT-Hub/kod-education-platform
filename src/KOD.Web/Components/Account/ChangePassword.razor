@page "/account/change-password"
@attribute [Authorize]

<PageTitle>@T("Зміна пароля · КОД")</PageTitle>

<header class="auth-card__header">
    <span class="ds-stat__icon ds-animate-pop"><Icon Name="key-round" /></span>
    <h1>@(IsForced ? T("Встановіть власний пароль") : T("Зміна пароля"))</h1>
    <p>
        @if (IsForced)
        {
            <span>@T("Ви увійшли з тимчасовим паролем. Задайте власний пароль, щоб продовжити роботу.")</span>
        }
        else
        {
            <span>@T("Після зміни пароля всі інші сесії буде завершено.")</span>
        }
    </p>
</header>

@if (ErrorMessage is not null)
{
    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
}

<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password" class="ds-form" Enhance data-busy-on-submit>
    <DataAnnotationsValidator />
    <Field Label="@T("Поточний пароль")" For="current-password">
        <PasswordReveal>
            <InputText id="current-password" type="password" @bind-Value="Input.CurrentPassword" class="ds-input" autocomplete="current-password" />
        </PasswordReveal>
        <ValidationError For="() => Input.CurrentPassword" />
    </Field>
    <Field Label="@T("Новий пароль")" For="new-password" Hint="@T("Щонайменше 12 символів: великі й малі латинські літери та цифри.")">
        <PasswordReveal>
            <InputText id="new-password" type="password" @bind-Value="Input.NewPassword" class="ds-input" autocomplete="new-password" />
        </PasswordReveal>
        <ValidationError For="() => Input.NewPassword" />
    </Field>
    <Field Label="@T("Повторіть новий пароль")" For="confirm-password">
        <PasswordReveal>
            <InputText id="confirm-password" type="password" @bind-Value="Input.ConfirmPassword" class="ds-input" autocomplete="new-password" />
        </PasswordReveal>
        <ValidationError For="() => Input.ConfirmPassword" />
    </Field>
    <Button Type="submit" Size="ControlSize.Large" Block>@T("Зберегти пароль")</Button>
</EditForm>

@if (!IsForced)
{
    <Button Href="/profile/security" Variant="ButtonVariant.Ghost" Icon="arrow-left">@T("Повернутися")</Button>
}
