@page "/account/login"
@attribute [AllowAnonymous]

<PageTitle>@T("Вхід · КОД")</PageTitle>

<div class="auth-mobile-brand"><span class="app-brand__mark">@T("К")</span> @T("КОД")</div>
<header class="auth-card__header">
    <h1>@T("Вхід до кабінету")</h1>
    <p>@T("Увійдіть за обліковим записом, виданим адміністратором вашої організації.")</p>
</header>

@if (ErrorMessage is not null)
{
    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
}

<EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" class="ds-form" Enhance data-busy-on-submit>
    <DataAnnotationsValidator />
    <Field Label="@T("Електронна пошта")" For="login-email">
        <InputText id="login-email" @bind-Value="Input.Email" class="ds-input" autocomplete="username" inputmode="email" placeholder="name@company.ua" autofocus />
        <ValidationError For="() => Input.Email" />
    </Field>
    <Field Label="@T("Пароль")" For="login-password">
        <InputText id="login-password" type="password" @bind-Value="Input.Password" class="ds-input" autocomplete="current-password" />
        <ValidationError For="() => Input.Password" />
    </Field>
    <label class="ds-check">
        <InputCheckbox @bind-Value="Input.RememberMe" />
        <span class="ds-check__text">
            <span>@T("Запам'ятати мене на цьому пристрої")</span>
            <span class="ds-check__hint">@T("Не використовуйте на спільних комп'ютерах.")</span>
        </span>
    </label>
    <Button Type="submit" Size="ControlSize.Large" Block IconEnd="arrow-right">@T("Продовжити")</Button>
</EditForm>

<p class="ds-text-sm ds-muted">
    @T("Якщо ви не маєте облікового запису або забули пароль — зверніться до відділу кадрів чи системного адміністратора.")
</p>
