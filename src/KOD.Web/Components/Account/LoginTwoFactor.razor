@page "/account/login-2fa"
@attribute [AllowAnonymous]

<PageTitle>@T("Підтвердження входу · КОД")</PageTitle>

<header class="auth-card__header">
    <span class="ds-stat__icon ds-animate-pop"><Icon Name="smartphone" /></span>
    <h1>@T("Код з автентифікатора")</h1>
    <p>@T("Відкрийте застосунок-автентифікатор і введіть 6-значний код для облікового запису КОД.")</p>
</header>

@if (ErrorMessage is not null)
{
    <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
}

<EditForm Model="Input" method="post" OnValidSubmit="VerifyAsync" FormName="login-2fa" class="ds-form" Enhance data-busy-on-submit>
    <DataAnnotationsValidator />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <input type="hidden" name="RememberMe" value="@RememberMe.ToString()" />
    <Field Label="@T("Код підтвердження")" For="otp-code">
        <OtpInput AutoSubmit>
            <InputText id="otp-code" @bind-Value="Input.Code" class="ds-input ds-otp__input" autocomplete="one-time-code" inputmode="numeric" maxlength="7" autofocus />
        </OtpInput>
        <ValidationError For="() => Input.Code" />
    </Field>
    <Button Type="submit" Size="ControlSize.Large" Block Icon="shield-check">@T("Увійти")</Button>
</EditForm>

<p class="ds-text-sm ds-muted">
    @T("Немає доступу до телефону?") <a class="ds-link" href="@RecoveryHref">@T("Увійти за резервним кодом")</a>.
</p>
