@page "/account/access-denied"
@attribute [AllowAnonymous]

<PageTitle>Доступ заборонено · КОД</PageTitle>

<header class="auth-card__header">
    <span class="ds-stat__icon ds-animate-pop"><Icon Name="lock" /></span>
    <h1>Доступ заборонено</h1>
    <p>У вашого облікового запису немає прав для цієї дії. Зверніться до керівника підрозділу або системного адміністратора.</p>
</header>
<Button Href="/" Icon="house">На головну</Button>
