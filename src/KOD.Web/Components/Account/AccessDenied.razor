@page "/account/access-denied"
@attribute [AllowAnonymous]

<PageTitle>@T("Доступ заборонено · КОД")</PageTitle>

<header class="auth-card__header">
    <span class="ds-stat__icon ds-animate-pop"><Icon Name="lock" /></span>
    <h1>@T("Доступ заборонено")</h1>
    <p>@T("У вашого облікового запису немає прав для цієї дії. Зверніться до керівника підрозділу або системного адміністратора.")</p>
</header>
<Button Href="/" Icon="house">@T("На головну")</Button>
