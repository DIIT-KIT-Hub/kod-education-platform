@page "/account/setup-authenticator"
@attribute [AllowAnonymous]

<PageTitle>@T("Підключення автентифікатора · КОД")</PageTitle>

@if (RecoveryCodes is not null)
{
    <header class="auth-card__header">
        <span class="sign-result__icon"><Icon Name="shield-check" Size="IconSize.ExtraLarge" /></span>
        <h1>@T("Автентифікатор підключено")</h1>
        <p>@T("Збережіть резервні коди в надійному місці. Вони знадобляться, якщо ви втратите доступ до телефону. Кожен код діє один раз.")</p>
    </header>
    <ul class="ds-codes ds-stagger">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <li>@recoveryCode</li>
        }
    </ul>
    <div class="ds-cluster">
        <button type="button" class="ds-btn ds-btn--secondary" data-copy="@string.Join(Environment.NewLine, RecoveryCodes)">
            <Icon Name="copy" /> <span>@T("Скопіювати коди")</span>
        </button>
        <Button Href="@ContinueHref" IconEnd="arrow-right">@T("Перейти до кабінету")</Button>
    </div>
}
else if (MustSetPassword)
{
    <header class="auth-card__header">
        <span class="ds-badge ds-badge--outline">@T("Крок {0} з {1}", 1, 2)</span>
        <h1>@T("Створіть власний пароль")</h1>
        <p>@T("Тимчасовий пароль від адміністратора діє лише для першого входу. Придумайте власний — після цього підключимо автентифікатор.")</p>
    </header>

    @if (ErrorMessage is not null)
    {
        <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
    }

    <EditForm Model="Password" method="post" OnValidSubmit="SetPasswordAsync" FormName="first-password" class="ds-form" Enhance data-busy-on-submit>
        <DataAnnotationsValidator />
        <Field Label="@T("Новий пароль")" For="first-password-new" Hint="@T("Від 12 символів: великі й малі літери та цифри. Паролі з відомих витоків не приймаються.")">
            <PasswordReveal>
                <InputText id="first-password-new" type="password" @bind-Value="Password.NewPassword" class="ds-input" autocomplete="new-password" />
            </PasswordReveal>
            <ValidationError For="() => Password.NewPassword" />
        </Field>
        <Field Label="@T("Повторіть пароль")" For="first-password-confirm">
            <PasswordReveal>
                <InputText id="first-password-confirm" type="password" @bind-Value="Password.ConfirmPassword" class="ds-input" autocomplete="new-password" />
            </PasswordReveal>
            <ValidationError For="() => Password.ConfirmPassword" />
        </Field>
        <Button Type="submit" Size="ControlSize.Large" Block IconEnd="arrow-right">@T("Зберегти пароль")</Button>
    </EditForm>
}
else
{
    <header class="auth-card__header">
        @if (WasTemporaryPassword)
        {
            <span class="ds-badge ds-badge--outline">@T("Крок {0} з {1}", 2, 2)</span>
        }
        <h1>@T("Захистіть вхід")</h1>
        <p>@T("Для кожного облікового запису обов'язкова двофакторна автентифікація. Прив'яжіть застосунок-автентифікатор — це займе хвилину.")</p>
    </header>

    <ol class="auth-steps">
        @if (Languages.Current == Languages.English)
        {
            <li><span>Install <strong>Google Authenticator</strong>, <strong>Microsoft Authenticator</strong> or another TOTP app.</span></li>
        }
        else
        {
            <li><span>Встановіть <strong>Google Authenticator</strong>, <strong>Microsoft Authenticator</strong> або інший TOTP-застосунок.</span></li>
        }
        <li>
            <div class="ds-stack ds-stack--sm">
                <span>@T("Відскануйте QR-код або введіть ключ вручну:")</span>
                @if (QrSvg is not null)
                {
                    <div class="auth-qr" role="img" aria-label="@T("QR-код для автентифікатора")">@((MarkupString)QrSvg)</div>
                }
                <div class="ds-row ds-row--wrap">
                    <code class="ds-code">@SharedKey</code>
                    <button type="button" class="ds-btn ds-btn--ghost ds-btn--sm" data-copy="@SharedKeyRaw"><Icon Name="copy" /> <span>@T("Копіювати")</span></button>
                </div>
            </div>
        </li>
        <li><span>@T("Введіть 6-значний код, який показує застосунок.")</span></li>
    </ol>

    @if (ErrorMessage is not null)
    {
        <Alert Tone="Tone.Danger">@ErrorMessage</Alert>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="EnrollAsync" FormName="setup-authenticator" class="ds-form" Enhance data-busy-on-submit>
        <DataAnnotationsValidator />
        <Field Label="@T("Код з застосунку")" For="enroll-code">
            <InputText id="enroll-code" @bind-Value="Input.Code" class="ds-input ds-input--code" autocomplete="one-time-code" inputmode="numeric" maxlength="7" placeholder="000000" />
            <ValidationError For="() => Input.Code" />
        </Field>
        <Button Type="submit" Size="ControlSize.Large" Block Icon="shield-check">@T("Підтвердити та увійти")</Button>
    </EditForm>
}
