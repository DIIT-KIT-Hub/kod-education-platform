@inherits LayoutComponentBase

<a class="app-skip" href="#main">@T("Перейти до змісту")</a>

<div class="app-shell">
    <aside id="app-sidebar" class="app-sidebar" aria-label="@T("Головне меню")">
        <a class="app-brand" href="/">
            <span class="app-brand__mark" aria-hidden="true">@T("К")</span>
            <span class="app-brand__text">
                <strong>@T("КОД")</strong>
                @if (Languages.Current == Languages.English)
                {
                    <small>Organizational<br />Documents Cabinet</small>
                }
                else
                {
                    <small>Кабінет організаційних<br />документів</small>
                }
            </span>
        </a>
        <NavMenu Items="Items" />
        <div class="app-sidebar__footer">
            <UserMenu />
        </div>
    </aside>

    @* Collapses the desktop sidebar to an icon rail; outside the aside so its scroll area does not clip the button. *@
    <button type="button" class="app-sidebar-toggle" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" aria-label="@T("Згорнути меню")" title="@T("Згорнути меню")">
        <Icon Name="chevron-left" />
    </button>

    <header class="app-topbar">
        <a class="app-brand app-brand--compact" href="/">
            <span class="app-brand__mark" aria-hidden="true">@T("К")</span>
            <strong>@T("КОД")</strong>
        </a>
        <div class="ds-row">
            <button type="button" class="ds-btn ds-btn--ghost ds-btn--icon ds-btn--sm" data-theme-toggle aria-label="@T("Змінити тему")">
                <Icon Name="moon" Class="app-theme-dark" />
                <Icon Name="sun" Class="app-theme-light" />
            </button>
            <button type="button" class="ds-btn ds-btn--ghost ds-btn--icon ds-btn--sm" popovertarget="app-drawer" aria-label="@T("Меню")">
                <Icon Name="menu" />
            </button>
        </div>
    </header>

    <div id="app-drawer" class="app-drawer" popover>
        <div class="app-drawer__header">
            <span class="ds-strong">@T("Меню")</span>
            <button type="button" class="ds-btn ds-btn--ghost ds-btn--icon ds-btn--sm" popovertarget="app-drawer" popovertargetaction="hide" aria-label="@T("Закрити меню")">
                <Icon Name="x" />
            </button>
        </div>
        <NavMenu Items="Items" />
        <UserMenu />
    </div>

    <main id="main" class="app-main" tabindex="-1">
        <div class="app-page">
            @Body
        </div>
    </main>

    <nav class="app-tabbar" aria-label="@T("Швидка навігація")">
        @foreach (var item in Items.Where(static i => i.ShowInTabBar).Take(5))
        {
            <NavLink class="app-tabbar__item" href="@item.Href" Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <Icon Name="@item.Icon" />
                <span>@item.Text</span>
            </NavLink>
        }
    </nav>
</div>

<div id="blazor-error-ui" class="app-error-ui" data-nosnippet>
    <Icon Name="triangle-alert" />
    <span>@T("Сталася помилка. Оновіть сторінку.")</span>
    <a href="." class="reload ds-btn ds-btn--sm ds-btn--secondary">@T("Оновити")</a>
</div>
