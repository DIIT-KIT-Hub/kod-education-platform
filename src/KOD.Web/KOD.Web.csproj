<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>KOD.Web</RootNamespace>
    <UserSecretsId>kod-web-3b8f9c52-6a41-4e0b-9d7e-2f5c1a7e8d10</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KOD.Application\KOD.Application.csproj" />
    <ProjectReference Include="..\KOD.Infrastructure\KOD.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Postgresql.Alternative" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime uploads are served by UseStaticFiles, not compiled into the static assets manifest. -->
    <Content Remove="wwwroot\uploads\**" />
    <None Remove="wwwroot\uploads\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translations are embedded resources (Directory.Build.props), not published content. -->
    <Content Remove="Localization\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KOD.UnitTests" />
  </ItemGroup>

</Project>
