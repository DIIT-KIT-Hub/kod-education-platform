@* The button switches the input between hidden and plain text (js/kod-ds.js, data-password-toggle). *@
<div class="ds-password">
    @ChildContent
    <button type="button" class="ds-password__toggle" data-password-toggle aria-pressed="false" aria-label="@T("Показати пароль")" title="@T("Показати пароль")">
        <Icon Name="eye" Class="ds-password__show" />
        <Icon Name="eye-off" Class="ds-password__hide" />
    </button>
</div>
