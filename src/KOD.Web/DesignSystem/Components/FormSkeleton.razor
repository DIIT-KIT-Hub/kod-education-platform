<div class="ds-split" role="status" aria-busy="true" aria-label="@T("Завантаження…")">
    <div class="ds-stack ds-stack--lg ds-skeleton-group" aria-hidden="true">
        @for (var card = 0; card < Cards; card++)
        {
            <div class="ds-card">
                <span class="ds-skeleton ds-skeleton--title" style="@($"width:{8 + (card * 3)}rem")"></span>
                <div class="ds-form-grid">
                    @for (var field = 0; field < Fields; field++)
                    {
                        <div class="ds-form-skeleton__field">
                            <span class="ds-skeleton ds-skeleton--text" style="@($"width:{5 + (((field * 5) + card) % 6)}rem")"></span>
                            <span class="ds-skeleton ds-skeleton--control"></span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <div class="ds-card" aria-hidden="true">
        <span class="ds-skeleton ds-skeleton--title" style="width:7rem"></span>
        <span class="ds-skeleton ds-skeleton--text" style="width:90%"></span>
        <span class="ds-skeleton ds-skeleton--text" style="width:65%"></span>
        <span class="ds-skeleton ds-skeleton--pill" style="height:3rem"></span>
    </div>
</div>
