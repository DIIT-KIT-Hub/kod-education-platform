<Card Href="@Href" Variant="@(Inverse ? CardVariant.Inverse : CardVariant.Default)">
    <div class="ds-stat">
        <div class="ds-row ds-row--between">
            <span class="ds-stat__icon"><Icon Name="@Icon" /></span>
            @if (Href is not null)
            {
                <Icon Name="arrow-right" Class="ds-muted" />
            }
        </div>
        <span class="ds-stat__value">@Value</span>
        <span class="ds-stat__label">@Label</span>
    </div>
</Card>
