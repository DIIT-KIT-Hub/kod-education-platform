<nav class="ds-pagination" aria-label="Сторінки">
    <span class="ds-pagination__summary">
        @FirstItem–@LastItem з @TotalCount.ToString("N0", Culture)
    </span>

    @if (TotalPages > 1)
    {
        <div class="ds-pagination__pages">
            <a class="ds-pagination__page" href="@PageHref(Page - 1)" aria-disabled="@(Page <= 1 ? "true" : null)" aria-label="Попередня сторінка">
                <Icon Name="chevron-left" />
            </a>
            @foreach (var item in Window)
            {
                if (item is null)
                {
                    <span class="ds-pagination__gap">…</span>
                }
                else
                {
                    <a class="ds-pagination__page"
                       href="@PageHref(item.Value)"
                       aria-current="@(item.Value == Page ? "page" : null)"
                       data-far="@(Math.Abs(item.Value - Page) > 1 && item.Value != 1 && item.Value != TotalPages ? "true" : null)">@item.Value</a>
                }
            }
            <a class="ds-pagination__page" href="@PageHref(Page + 1)" aria-disabled="@(Page >= TotalPages ? "true" : null)" aria-label="Наступна сторінка">
                <Icon Name="chevron-right" />
            </a>
        </div>
    }

    <form method="get" action="@CurrentPath" class="ds-pagination__size" data-enhance>
        @foreach (var (key, value) in PreservedQuery)
        {
            <input type="hidden" name="@key" value="@value" />
        }
        <label for="@SizeId" class="ds-muted">На сторінці</label>
        <select id="@SizeId" name="pageSize" class="ds-select ds-select--sm" data-autosubmit>
            @foreach (var size in PageSizes)
            {
                <option value="@size" selected="@(size == PageSize)">@size</option>
            }
        </select>
        <noscript><button type="submit" class="ds-btn ds-btn--sm ds-btn--secondary">OK</button></noscript>
    </form>
</nav>
