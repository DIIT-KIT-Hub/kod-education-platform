<div class="ds-empty">
    <div class="ds-empty__icon"><Icon Name="@Icon" Size="IconSize.Large" /></div>
    <p class="ds-empty__title">@Title</p>
    @if (Text is not null)
    {
        <p class="ds-empty__text">@Text</p>
    }
    @if (ChildContent is not null)
    {
        <div class="ds-cluster">@ChildContent</div>
    }
</div>
